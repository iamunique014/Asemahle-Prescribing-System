@model IEnumerable<PrescribingSystem.Models.PrescriptionOrders>
@{
    ViewData["Title"] = "My Orders";
    //Layout = "_CustomerLayout";

    var collected = Model
       .Where(o => o.OrderStatus == OrderStatus.Collected)
       .OrderBy(o => o.OrderDate)
       .ToList();

    var pending = Model
        .Where(o => o.OrderStatus != OrderStatus.Collected)
        .OrderByDescending(o => o.OrderDate)
        .ToList();
}

<div class="container mt-4">
    <h2>My Orders</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have not placed any orders yet!.
        </div>
    }
    else
    {

        <!-- Tabs navigation -->
        <ul class="nav nav-tabs form-container p-3" id="orderTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab" aria-controls="pending" aria-selected="true">
                    Current Orders
                    <span class="badge ms-1">@pending.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="collected-tab" data-bs-toggle="tab" data-bs-target="#collected" type="button" role="tab" aria-controls="collected" aria-selected="false">
                    Collected Orders
                    <span class="badge ms-1">@collected.Count</span>
                </button>
            </li>
        </ul>


        <!-- Tabs content -->
        <div class="tab-content mt-3 px-2" id="ordersTabsContent">
            <!-- Orders that haven't been collected' -->
            <div class="tab-pane fade show active" id="pending" role="tabpanel" aria-labelledby="pending-tab">
                @if (pending.Any())
                {
                    <table class="table table-striped table-dark">
                        <thead>
                            <tr>
                                <th>Order Date</th>
                                <th>Order Status</th>
                                <th>Total Cost</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in pending)
                            {
                                <tr>
                                    <td>@order.OrderDate.ToString("dddd, dd, MMMM, HH:mm")</td>
                                     <td>
                                        <span class="text-dark badge bg-@(order.OrderStatus switch {
                                            OrderStatus.Pending => "warning",
                                            OrderStatus.Collected => "success",
                                            OrderStatus.ReadyForCollection => "secondary",
                                            _ => "info"
                                        })">@order.OrderStatus</span>
                                    </td>
                                    <td>@order.TotalCost.ToString("c")</td>
                                    <td>
                                        <a href="@Url.Action("CustomerOrderDetails", "CustomerOrders", new { PrescriptionOrdersId  = order.PrescriptionOrdersId })"
                                           class="btn btn-success">
                                            Open
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                 
                }
                else
                {
                    <div class="alert alert-info">You have no pending orders yet.</div>
                }
            </div>

            <!-- Collected Orders -->
            <div class="tab-pane fade" id="collected" role="tabpanel" aria-labelledby="collected-tab">
                @if (collected.Any())
                {
                    <table class="table table-striped table-dark">
                        <thead>
                            <tr>
                                <th>Order Date</th>
                                <th>Collection Date</th>
                                <th>Order Status</th>
                                <th>Total Cost</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in collected)
                            {
                                <tr>
                                    <td>@order.OrderDate.ToString("dddd, dd, MMMM, HH:mm")</td>
                                    <td>
                                        @order.CollectedDate
                                    </td>
                                    <td>
                                        <span class="badge bg-success">@order.OrderStatus</span>
                                    </td>
                                   <td>@order.TotalCost.ToString("c")</td>
                                    <td>
                                        <a href="@Url.Action("CustomerOrderDetails", "CustomerOrders", new { PrescriptionOrdersId = order.PrescriptionOrdersId })"
                                           class="btn btn-success">
                                            Open
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                  
                }
                else
                {
                    <div class="alert alert-light">No Collected Orders yet.</div>
                }
            </div>
        </div>

    }
</div>

