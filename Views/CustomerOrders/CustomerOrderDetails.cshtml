@model PrescribingSystem.Models.PrescriptionOrders
<div class="container mt-4">
    <h2>Order Details</h2>

    <div class="card mb-3">
        <div class="card-body">
            @* <h5>Order #@Model.PrescriptionOrdersId</h5> *@
            <p><strong>Date:</strong> @Model.OrderDate.ToString("dd MMM yyyy")</p>
            <p><strong>Status:</strong> <span class="badge bg-primary">@Model.OrderStatus</span></p>
            <p><strong>Total Cost:</strong> R @Model.TotalCost.ToString("0.00")</p>
        </div>
    </div>

    <table class="table table-dark">
        <thead>
            <tr>
                <th>Medication</th>
                <th>Doctor</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Line Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderItems)
            {
                <tr>
                    <td>@item.MedicationItem.Medication.Name</td>
                    <td>@item.MedicationItem.Prescription.DoctorName</td>
                    <td>@item.QuantityOrdered</td>
                    <td>R @item.UnitPrice.ToString("0.00")</td>
                    <td>R @item.LineTotal.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-action="MyOrders" class="btn btn-secondary">Back to Orders</a>

</div>