@{
    Layout = "_PharmacistLayout";
}

<body>
    <h3>
        More Information
    </h3>

    <div class="grid-container">
        <div>
            <div class="form-group">
                <label class="control-label">Name:</label>
                <span class="form-control">Dr. Smith</span>
            </div>
            <div class="form-group">
                <label class="control-label">Email Address:</label>
                <span class="form-control">smith@email.com</span>
            </div>
            <div class="form-group">
                <label class="control-label">Contact Number:</label>
                <span class="form-control">0123456789</span>
            </div>
            <div class="form-group">
                <label class="control-label">Practice Number:</label>
                <span class="form-control">PR123456</span>
            </div>
        </div>
    </div>
    <div class="grid-container">
        <div class="row">
            <div class="col-6">
                <h4 class="mb-3">Uploaded Orders</h4>
                <ul class="list-group">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Amoxicillin Prescription.pdf
                        <span class="badge bg-secondary">2025-05-12</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Ibuprofen Order.pdf
                        <span class="badge bg-secondary">2025-05-15</span>
                    </li>
                </ul>
            </div>
            <div class="col-6">
                <div class="col-6">
                    <h4 class="mb-3">Prescribed Orders</h4>
                    <ul class="list-group">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Order #008
                            <span class="badge bg-primary">2025-05-14</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Order #024
                            <span class="badge bg-primary">2025-05-18</span>
                        </li>
                    </ul>
                </div>

            </div>
        </div>
        <a class="btn btn-dark" asp-action="LoadOrders" asp-controller="Pharmacist">Back</a>
        <button type="button" class="btn btn-info btn-md" data-bs-toggle="modal" data-bs-target="#orderloadingModal">Upload Prescription</button>
    </div>

    <div class="modal fade" id="orderloadingModal" tabindex="-1" aria-labelledby="loadedPrescription" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class=modal-content>
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title" id="loadedPrescription">Upload Orders </h4>
                </div>

                <div class="modal-body">
                    <div class="input-group">
                        <label class="control-label">Order By:</label>
                        <input class="form-control" readonly value="Dr. Smith" />
                    </div>
                    <div class="input-group">
                        <label class="control-label">Date:</label>
                        <input class="form-control" type="date" />
                    </div>
                    <div class="form-group">
                        <label class="control-label">Attach document:</label>
                        <div class="col-sm-10">
                            <div class="form-file">
                                <input type="file" id="documentUpload" class="form-control custom-file-input" multiple />
                                <label class="custom-file-label">Choose File....</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="previewContainer"></div>
                <button type="submit" class="btn btn-dark" onclick="processUpload()">Upload</button>

            </div>
        </div>
    </div>
</body>

<script>
    function processUpload() {
        const proceed = confirm("Would you like to process this order now?");
        if(proceed){

        }
        else{

        }
    }
</script>

