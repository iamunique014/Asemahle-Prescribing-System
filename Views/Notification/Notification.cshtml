        .nav-tip {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: #eef6ff;
            color: #003366;
            padding: 10px 15px;
            border: 1px solid #b3d4fc;
            border-radius: 8px;
            margin: 10px 0;
            font-size: 0.95rem;
            position: relative;
        }

            .nav-tip button {
                background: none;
                border: none;
                font-size: 1.2rem;
                color: #003366;
                cursor: pointer;
            }

                .nav-tip button:hover {
                    color: #ff4d4f;
                }

        h2 {
            margin-bottom: 20px;
            font-size: 22px;
            color: #333;
        }

        label {
            display: block;
            margin-top: 15px;
            margin-bottom: 5px;
            font-weight: bold;
        }

        select, button {
            width: 100%;
            padding: 10px;
            margin-bottom: 15px;
            border-radius: 8px;
            border: 1px solid #ccc;
            font-size: 16px;
        }

        button {
            background: #007bff;
            color: white;
            border: none;
            cursor: pointer;
            transition: background 0.3s ease;
        }

            button:hover {
                background: #0056b3;
            }

        .message {
            margin-top: 10px;
            color: green;
        }
    </style>
</head>

<body>
    <header>

        <nav class="section__container nav__container">
            <div class="nav__logo">Ibhayi-<span>Pharmacy</span></div>
            <nav class="section__container nav__container" color="black">
                @* <div class="nav__logo">e-<span>Nompilo</span></div> *@
                <ul class="nav__links">
                    <li class="nav-item">
                        <a class="nav__logo" asp-area="" asp-controller="Customer" asp-action="CustomerCare">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav__logo" asp-area="" asp-controller="AboutUs" asp-action="AboutUs">About Us</a>
                    </li>
                    <li class="nav-item active">
                        <a class="nav__logo" asp-area="" asp-controller="Profile" asp-action="Profile">Profile</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav__logo" asp-area="" asp-controller="ContactUs" asp-action="ContactUs">Contact Us</a>
                    </li>
                </ul>
            </nav>
            <div><a class="btn btn-primary" asp-area="" asp-controller="Profile" asp-action="Profile">Registration</a></div>
        </nav>
        </header>
    <div id="navTip" class="nav-tip">
        <span>💡 Tip: For Primary contact select the most option as it will bw used for first or emergency.</span>
        <button onclick="document.getElementById('navTip').remove()">×</button>
    </div>
    <div class="container">
        <h2>Choose Your Notification Preferences</h2>

        <label for="primary">Primary Method</label>
        <select id="primary">
            <option value="">-- Select Primary --</option>
            <option value="SMS">SMS</option>
            <option value="Email">Email</option>
            <option value="App Notification">App Notification</option>
            <option value="WhatsApp">WhatsApp</option>
        </select>

        <label for="secondary">Secondary Method</label>
        <select id="secondary">
            <option value="">-- Select Secondary --</option>
            <option value="SMS">SMS</option>
            <option value="Email">Email</option>
            <option value="App Notification">App Notification</option>
            <option value="WhatsApp">WhatsApp</option>
        </select>

        <button onclick="savePreferences()">Save Preferences</button>
        <div id="message" class="message"></div>
    </div>


    <script>
        function savePreferences() {
          const primary = document.getElementById("primary").value;
          const secondary = document.getElementById("secondary").value;
          const message = document.getElementById("message");

          if (!primary || !secondary) {
            message.textContent = "Please select both primary and secondary methods.";
            message.style.color = "red";
            return;
          }

          if (primary === secondary) {
            message.textContent = "Primary and secondary methods must be different.";
            message.style.color = "red";
            return;
          }

          message.textContent = `Saved! Primary: ${primary}, Secondary: ${secondary}`;
          message.style.color = "green";

          // Here you would send data to your server using fetch/ajax if needed
        }
    </script>









