@model PrescribingSystem.Models.ViewModels.reportViewmodel;


@{
    Layout = "_LayoutReports";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.4.0/fonts/remixicon.css"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/css/CustomerCare.css" asp-append-version="true" />@* 
     *@
    <title>The Innovative Geeks | eNompilo</title>

</head>
<body>

    <header>

        <nav class="section__container nav__container">
            <div class="nav__logo">Ibhayi-<span>Pharmacy</span></div>
            <nav class="section__container nav__container" color="black">
                @* <div class="nav__logo">e-<span>Nompilo</span></div> *@
                <ul class="nav__links">
                    <li class="nav-item">
                        <a class="nav__logo" asp-area="" asp-controller="Customer" asp-action="CustomerCare">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav__logo" asp-area="" asp-controller="AboutUs" asp-action="AboutUs">About Us</a>
                    </li>
                    <li class="nav-item active">
                        <a class="nav__logo" asp-area="" asp-controller="Services" asp-action="Services">Services</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav__logo" asp-area="" asp-controller="ContactUs" asp-action="Add">Contact Us</a>
                    </li>
                </ul>
            </nav>
            <div><a class="btn btn-primary" asp-area="" asp-controller="Customer" asp-action="Reports">View Reports</a></div>
        </nav>

    </header>


    <section style=" padding: 20px; border-radius: 8px; margin-bottom: 20px;">
        <h2>Welcome to the Reports Dashboard!</h2>
        <p>Here you can generate and review detailed prescription and order reports. Use the options below to customize your view and gain valuable insights.</p>
    </section>






    <div class="container mt-4">
        <div id="pharmacyCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#pharmacyCarousel" data-bs-slide-to="0" class="active"></button>
                <button type="button" data-bs-target="#pharmacyCarousel" data-bs-slide-to="1"></button>
                <button type="button" data-bs-target="#pharmacyCarousel" data-bs-slide-to="2"></button>
            </div>
            <div class="carousel-inner rounded shadow">
                <div class="carousel-item active">
                    <img src="~/css/Image1.jpg" class="d-block w-100" alt="Health Product" />
                    <div class="carousel-caption d-none d-md-block">
                        <h5 class="text-black">Reliable Prescription Services</h5>
                        <p class="text-black">Fast, accurate, and secure medication dispensing.</p>
                    </div>
                </div>
                <div class="carousel-item">
                    @*  <img src="~/images/image2.jpg" class="d-block w-100" alt="Health Products"> *@
                    <img src="~/css/image2.jpg" class="d-block w-100" alt="Health Product" />
                    <div class="carousel-caption d-none d-md-block">
                        <h5 class="text-black">Wide Range of Health Products</h5>
                        <p class="text-black">From supplements to skincare, we've got you covered.</p>
                    </div>
                </div>
                <div class="carousel-item">
                    <img src="~/css/Image3.jpg" class="d-block w-100" alt="Health Product" />
                    <div class="carousel-caption d-none d-md-block">
                        <h5 class="text-black">Expert Health Advice</h5>
                        <p class="text-black">Talk to our pharmacists for guidance and support.</p>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#pharmacyCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#pharmacyCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
    </div>


    <style>
        .content {
            text-align: center; /* Center heading + paragraph */
            margin: 80px 0; /* Space above and below the section */
        }

            .content h1 {
                font-size: 48px; /* Make heading big */
                margin-bottom: 20px; /* Space between heading and paragraph */
            }

            .content p {
                font-size: 18px; /* Optional: style the paragraph */
                max-width: 600px;
                margin: 0 auto; /* Center paragraph with limited width */
            }
    </style>
    <div class="content ">

        <h1>Generate Report</h1>
        <p>Please quickly Fill in the Form below to geneate the report.</p>


    </div>
    <style>
        .form-section {
            padding: 40px 20px;
            background-color: #f9f9f9;
            text-align: center;
        }

            .form-section form {
                margin-bottom: 40px; /* Space below the form, before the button */
            }


        footer {
            background-color: #333;
            color: white;
            text-align: center;
            padding: 20px 0;
        }
    </style>

    <form asp-action="GenerateReport" method="post" class="form-section">
        <div class="form-group">
            <label>Start Date</label>
            <input asp-for="StartDate" type="date" class="form-control" />
        </div>
        <div class="form-group">
            <label>End Date</label>
            <input asp-for="EndDate" type="date" class="form-control" />
        </div>

        <div class="form-group">
            <label>Group By</label><br />
            <input type="radio" asp-for="GroupBy" value="Patient" /> Patient
            <input type="radio" asp-for="GroupBy" value="Doctor" /> Doctor
            <input type="radio" asp-for="GroupBy" value="Medication" /> Medication
        </div>

        <div class="form-group">
            <label>Patient Name</label>
            <input asp-for="PatientName" class="form-control" />
        </div>

        <div class="form-group">
            <label>Doctor Name</label>
            <input asp-for="DoctorName" class="form-control" />
        </div>

        <div class="form-group">
            <label>Medication Name</label>
            <input asp-for="MedicationName" class="form-control" />
        </div>








    </form>
    <style>
        body {
            font-family: Arial, sans-serif;
        }
        /* Button Style */
        #generateBtn {
            padding: 10px 20px;
            background-color: black;
            color: white;
            border: none;
            cursor: pointer;
            font-size: 16px;
            border-radius: 5px;
        }

        /* The Modal (background) */
        .modal {
            display: none;
            position: fixed;
            z-index: 1;
            padding-top: 100px;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0,0,0,0.5);
        }

        /* Modal Content */
        .modal-content {
            background-color: white;
            margin: auto;
            padding: 20px;
            border: 1px solid #888;
            width: 50%;
            border-radius: 10px;
            text-align: center;
        }

        /* Close Button */
        .close {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
        }

        button {
            padding: 12px 30px;
            font-size: 16px;
            text-align: right;
            padding: 900px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            margin-bottom: 60px; /* Space between button and footer */
        }
    </style>
    <div style="text-align: right; padding: 20px;">
        <button id="generateBtn">Generate Report</button>
    </div>
    @*      <button id="generateBtn">Generate Report</button>  *@

    <!-- The Modal -->
    <div id="popupModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h2>Generating Report...</h2>
            <p>Please wait while we process your request.</p>
        </div>
    </div>
    <script>
        const btn = document.getElementById("generateBtn");
        const modal = document.getElementById("popupModal");
        const closeBtn = document.getElementsByClassName("close")[0];

        btn.onclick = function() {
          modal.style.display = "block";
          // Simulate processing time
          setTimeout(() => {
            modal.style.display = "none";
            alert("Report Generated Successfully!");
          }, 3000); // 3 seconds delay
        }

        closeBtn.onclick = function() {
          modal.style.display = "none";
        }

        window.onclick = function(event) {
          if (event.target == modal) {
            modal.style.display = "none";
          }
        }
    </script>


    @if (ViewBag.Message != null)
    {
        <div class="alert alert-info mt-3">@ViewBag.Message</div>
    }



    <footer class="footer">
        <div class="section__container footer__container">
            <div class="footer__col">
                <h3>IBhayi-<span>Pharmacy</span></h3>
                <p>
                    We are honored to be a part of your healthcare journey and committed
                    to delivering compassionate, personalized, and top-notch care every
                    step of the way.
                </p>
                <p>
                    Trust us with your health, and let us work together to achieve the
                    best possible outcomes for you and your loved ones.
                </p>
            </div>
            <div class="footer__col">
                <h4>About Us</h4>
                <p>Home</p>
                <p>About Us</p>
                <p>Work With Us</p>
                <p>Our Blog</p>
                <p>Terms & Conditions</p>
            </div>
            <div class="footer__col">
                <h4>Services</h4>
                <p>Search Terms</p>
                <p>Advance Search</p>
                <p>Privacy Policy</p>

            </div>
            <div class="footer__col">
                <h4>Contact Us</h4>
                <p>
                    <i class="ri-map-pin-2-fill"></i> 64, Mackay str Richmond Hill, Port Elizabeth
                </p>
                <p><i class="ri-mail-fill"></i> IbhayiPharmacy@gmail.com</p>
                <p><i class="ri-phone-fill"></i> (+012) 3456 789</p>
            </div>
        </div>




        <div class="footer__bar">
            <div class="footer__bar__content">
                <p>Copyright © 2025 Ibhayi Pharmacy. All rights reserved.</p>
                <div class="footer__socials">
                    <span><i class="ri-instagram-line"></i></span>
                    <span><i class="ri-facebook-fill"></i></span>
                    <span><i class="ri-heart-fill"></i></span>
                    <span><i class="ri-twitter-fill"></i></span>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>
