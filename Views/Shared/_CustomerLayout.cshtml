<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Serif:ital,opsz,wght@0,8..144,100..900;1,8..144,100..900&display=swap" rel="stylesheet">
    <link href="~/css/customerlayout.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
</head>
<body>
    <nav class="sidebar close">
        <header>
            <div class="image-text">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><img class="img-fluid me-2" src="~/css/preview.png" /></a>
                <div class="text header-text">
                    <a asp-controller="Home" asp-action="Index">
                        <span class="name">Ibhayi Pharmacy</span>
                        <span class="profession"></span>
                    </a>
                    
                </div>
            </div>
            <i class='bx bx-chevron-right toggle'></i>
        </header>

        <div class="menu-bar">
            <div class="menu">
                <ul class="menu-links">
                    <li class="nav-link">                        
                        <a href="/Landing/Landing">
                            <i class='bx bx-home icon'></i>
                            <span class="text nav-text">Home</span>
                        </a>
                    </li>
                    <li class="nav-link">
                        <a asp-action="MyPrescriptions" asp-controller="Prescription">
                            <i class='bx bx-cabinet icon'></i>
                            <span class="text nav-text">MyPrescriptions</span>
                        </a>
                    </li>
                    @* <li class="nav-link">
                        <a asp-action="MyReports" asp-controller="Customer">
                            <i class='bx bx-spreadsheet icon'></i>
                            <span class="text nav-text">My Reports</span>
                        </a>
                    </li> *@
                   @*  <li class="nav-link">
                        <a href="#">
                            <i class='bx bx-home icon'></i>
                            <span class="text nav-text"></span>
                        </a>
                    </li> *@
                    <li class="nav-link">
                        <a asp-action="Upload" asp-controller="Prescription">
                            <i class='bx bxs-user-plus icon'></i>
                            <span class="text nav-text">Upload Prescription</span>
                        </a>
                    </li>
                    <li class="nav-link">
                        <a asp-action="MyOrders" asp-controller="Prescription">
                            <i class='bx bx-calendar-event icon'></i>
                            <span class="text nav-text">My Orders</span>
                        </a>
                    </li>
                    <li class="nav-link">
                        <a asp-action="MyReports" asp-controller="CustomerReports">
                            <i class='bx bxs-report icon'></i>
                            <span class="text nav-text">My Reports</span>
                        </a>
                    </li>
                </ul>

            </div>
        </div>
    </nav>
    <div style="margin-left:20%">
        @RenderBody()
    </div>
</body>
</html>
