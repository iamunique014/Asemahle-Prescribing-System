@{
    Layout = "_LayoutCustomerCare";

}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.4.0/fonts/remixicon.css"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/css/CustomerCare.css" asp-append-version="true" />

    <title>Manange Repeats</title>
    <style>
        body {
    font-family: Arial, sans-serif;
    margin: 40px;
    background-color: #f9f9f9;
    }
    h1 {
    text-align: center;
    }
    table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
    background-color: white;
    }
    th, td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid #ccc;
    }
    th {
    background-color: #4CAF50;
    color: white;
    }
    button {
    padding: 6px 12px;
    background-color: #4CAF50;
    color: white;
    border: none;
    cursor: pointer;
    }
    button:hover {
    background-color: #45a049;
    }
    .modal {
    display: none;
    position: fixed;
    z-index: 1;
    left: 0; top: 0;
    width: 100%; height: 100%;
    background-color: rgba(0,0,0,0.5);
    }
    .modal-content {
    background-color: white;
    margin: 15% auto;
    padding: 20px;
    width: 30%;
    text-align: center;
    border-radius: 5px;
    }

        input[type="text"] {
            width: 300px;
            padding: 10px;
            margin-bottom: 20px;
            border: 1px solid #ccc;
            font-size: 16px;
        }
    </style>

</head>
<body>

    <header>

        <nav class="section__container nav__container">
            <div class="nav__logo">Ibhayi-<span>Pharmacy</span></div>
            <nav class="section__container nav__container" color="black">
                @* <div class="nav__logo">e-<span>Nompilo</span></div> *@
                <ul class="nav__links">
                    <li class="nav-item">
                        <a class="nav__logo" asp-area="" asp-controller="Customer" asp-action="CustomerCare">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav__logo" asp-area="" asp-controller="AboutUs" asp-action="AboutUs">About Us</a>
                    </li>
                    <li class="nav-item active">
                        <a class="nav__logo" asp-area="" asp-controller="Profile" asp-action="Profile">Profile</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav__logo" asp-area="" asp-controller="ContactUs" asp-action="ContactUs">Contact Us</a>
                    </li>
                </ul>
            </nav>
            <div><a class="btn btn-primary" asp-area="" asp-controller="Profile" asp-action="Profile">Registration</a></div>
        </nav>
    </header>




    <h1>My Prescription Repeats</h1>
    <!-- Search Bar -->
    <input type="text" id="searchInput" placeholder="Search medication..." onkeyup="searchRepeats()">
    <table id="repeatsTable">
        <thead>
            <tr>
                <th>Medication</th>
                <th>Prescription Date</th>
                <th>Doctor</th>
                <th>Total Repeats</th>
                <th>Repeats Left</th>
                <th>Last Dispensed</th>
                <th>Next Eligible Date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <!-- Rows dynamically generated -->
        </tbody>
    </table>

    <!-- Confirmation Modal -->
    <div id="confirmModal" class="modal">
        <div class="modal-content">
            <p id="modalText"></p>
            <button onclick="confirmRequest()">Confirm</button>
            <button onclick="closeModal()">Cancel</button>
        </div>
    </div>


















    <footer class="footer">
        <div class="section__container footer__container">
            <div class="footer__col">
                <h3>IBhayi-<span>Pharmacy</span></h3>
                <p>
                    We are honored to be a part of your healthcare journey and committed
                    to delivering compassionate, personalized, and top-notch care every
                    step of the way.
                </p>
                <p>
                    Trust us with your health, and let us work together to achieve the
                    best possible outcomes for you and your loved ones.
                </p>
            </div>
            <div class="footer__col">
                <h4>About Us</h4>
                <p>Home</p>
                <p>About Us</p>
                <p>Work With Us</p>
                <p>Our Blog</p>
                <p>Terms & Conditions</p>
            </div>
            <div class="footer__col">
                <h4>Services</h4>
                <p>Search Terms</p>
                <p>Advance Search</p>
                <p>Privacy Policy</p>

            </div>
            <div class="footer__col">
                <h4>Contact Us</h4>
                <p>
                    <i class="ri-map-pin-2-fill"></i> 64, Mackay str Richmond Hill, Port Elizabeth
                </p>
                <p><i class="ri-mail-fill"></i> IbhayiPharmacy@gmail.com</p>
                <p><i class="ri-phone-fill"></i> (+012) 3456 789</p>
            </div>
        </div>
        <div class="footer__bar">
            <div class="footer__bar__content">
                <p>Copyright © 2025 Ibhayi Pharmacy. All rights reserved.</p>
                <div class="footer__socials">
                    <span><i class="ri-instagram-line"></i></span>
                    <span><i class="ri-facebook-fill"></i></span>
                    <span><i class="ri-heart-fill"></i></span>
                    <span><i class="ri-twitter-fill"></i></span>
                </div>
            </div>
        </div>
    </footer>
    <script src="/js/Re.js"></script>
</body>
</html>