@model IEnumerable<PrescribingSystem.Models.ActiveIngredients>

@{
    ViewData["Title"] = "Active Ingredients";
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

<div class="container mt-5">
    <div class="border p-4 rounded shadow bg-light">
        <h2 class="text-center text-primary mb-4">Active Ingredients</h2>

        <div class="text-center mb-3">
            <a asp-action="AddActiveIngredient" class="btn btn-success me-2">
                <i class="fas fa-plus"></i> Create New Active Ingredient
            </a>
            <a asp-action="Manager" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>

        <table class="table table-bordered table-striped table-dark">
            <thead>
                <tr>
                    <th>Ingredient Name</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ActiveIngredientName</td>
                        <td class="text-center">
                            <div class="btn-group" role="group" aria-label="Ingredient Actions">
                                <a asp-action="EditActiveIngredient" asp-route-id="@item.ActiveIngredientId" class="btn btn-sm btn-primary me-1">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a asp-action="ActiveIngredientsDetails" asp-route-id="@item.ActiveIngredientId" class="btn btn-sm btn-info me-1">
                                    <i class="fas fa-info-circle"></i> Details
                                </a>
                                <a asp-action="DeleteActiveIngredients" asp-route-id="@item.ActiveIngredientId" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
