@model PrescribingSystem.Models.ViewModels.StockOrderViewModel

@{
    ViewData["Title"] = "Stock Order Details";
}

<h2>Stock Order Details</h2>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Order Number</dt>
            <dd class="col-sm-9">@Model.OrderNumber</dd>

            <dt class="col-sm-3">Supplier</dt>
            <dd class="col-sm-9">@ViewBag.SupplierName</dd>

            <dt class="col-sm-3">Order Date</dt>
            <dd class="col-sm-9">@Model.OrderDate.ToShortDateString()</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@((Model.Status) ? "Completed" : "Pending")</dd>
        </dl>

        <a asp-action="IndexStock" class="btn btn-secondary">Back to List</a>
        <a asp-action="EditStock" asp-route-id="@Model.StockOrderId" class="btn btn-primary">Edit</a>
        <a asp-action="DeleteStock" asp-route-id="@Model.StockOrderId" class="btn btn-danger">Delete</a>
    </div>
</div>
