@model PrescribingSystem.Models.Pharmacist

@{
    ViewData["Title"] = "Delete Pharmacist";
}

<h2>Delete Pharmacist</h2>

<h3>Are you sure you want to delete this pharmacist?</h3>

<div>
    <h4>Pharmacist</h4>
    <hr />
    <dl class="row">
        @* <dt class="col-sm-2">Full Name</dt>
        <dd class="col-sm-10">@Model.FullName</dd> *@

        <dt class="col-sm-2">Cellphone</dt>
        <dd class="col-sm-10">@Model.Cellphone</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Health Council</dt>
        <dd class="col-sm-10">@Model.HealthCouncil</dd>

        <dt class="col-sm-2">Registration Number</dt>
        <dd class="col-sm-10">@Model.RegistrationNumber</dd>
    </dl>
</div>

<form asp-action="DeletePharmacist">
    <input type="hidden" asp-for="PharmacistId" />
    <button type="submit" class="btn btn-danger">Delete</button> |
    <a asp-action="IndexPharmacist" class="btn btn-secondary">Cancel</a>
</form>
