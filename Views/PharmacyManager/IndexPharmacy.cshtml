@model IEnumerable<PrescribingSystem.Models.Pharmacy>

@{
    ViewData["Title"] = "Pharmacy List";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<div class="container mt-4">
    <div class="border p-4 rounded shadow bg-light">

        <h1 class="mb-4 text-center">Pharmacies</h1>

        <!-- 🌐 Navbar with Actions -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white border rounded mb-4 px-3 shadow-sm">
            <div class="container-fluid">
                <a asp-action="CreatePharmacy" class="btn btn-success me-2">
                    <i class="fas fa-plus"></i> Add Pharmacy
                </a>
                <a asp-action="Manager" class="btn btn-primary">
                    <i class="fas fa-arrow-left"></i> Back
                </a>
            </div>
        </nav>

        <!-- 📋 Pharmacy Table -->
        <div class="table-responsive">
            <table class="table table-dark table-bordered table-striped">
                <thead>
                    <tr>
                        <th style="width: 15%;">Name</th>
                        <th style="width: 15%;">Health Council Reg. #</th>
                        <th style="width: 15%;">Physical Address 1</th>
                        <th style="width: 15%;">Physical Address 2</th>
                        <th style="width: 10%;">Contact</th>
                        <th style="width: 10%;">Email</th>
                        <th style="width: 10%;">Website</th>
                        <th style="width: 15%;">Pharmacist</th>
                        <th style="width: 15%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.HealthCouncilRegistrationNumber</td>
                            <td>@item.PhysicalAddress1</td>
                            <td>@item.PhysicalAddress2</td>
                            <td>@item.ContactNumber</td>
                            <td>@item.Email</td>
                            <td>@item.WebsiteUrl</td>
                            <td>
                                @item.Pharmacist?.Name @item.Pharmacist?.Surname - @item.Pharmacist?.RegistrationNumber
                            </td>
                            <td>
                                <a asp-action="EditPharmacy" asp-route-id="@item.PharmacyId" class="btn btn-sm btn-primary mb-1">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a asp-action="PharmacyDetails" asp-route-id="@item.PharmacyId" class="btn btn-sm btn-info mb-1">
                                    <i class="fas fa-info-circle"></i> Details
                                </a>
                                <a asp-action="DeletePharmacy" asp-route-id="@item.PharmacyId" class="btn btn-sm btn-danger mb-1">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
