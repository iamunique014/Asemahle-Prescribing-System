@model IEnumerable<PrescribingSystem.Models.Pharmacy>

@{
    ViewData["Title"] = "Pharmacy List";
}

<h1>Pharmacies</h1>

<p>
    <a asp-action="CreatePharmacy" class="btn btn-success">
        <i class="fas fa-plus"></i> Add Pharmacy
    </a>
</p>

<table class="table table-bordered table-striped table-responsive">
    <table class="table table-dark table-striped table-bordered">
            <th style="width: 15%;">Name</th>
            <th style="width: 15%;">Health Council Reg. #</th>
            <th style="width: 15%;">Physical Address 1</th>
            <th style="width: 15%;">Physical Address 2</th>
            <th style="width: 10%;">Contact</th>
            <th style="width: 10%;">Email</th>
            <th style="width: 10%;">Website</th>
            <th style="width: 15%;">Responsible Pharmacist</th>
            <th style="width: 5%;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.HealthCouncilRegistrationNumber</td>
                <td>@item.PhysicalAddress1</td>
                <td>@item.PhysicalAddress2</td>
                <td>@item.ContactNumber</td>
                <td>@item.Email</td>
                <td>@item.WebsiteUrl</td>
                <td>@item.Pharmacist.Name @item.Pharmacist.Surname - @item.Pharmacist.RegistrationNumber</td>
                <td>
                        <a asp-action="EditPharmacy" asp-route-id="@item.PharmacyId" class="btn btn-sm btn-primary">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                    <a asp-action="PharmacyDetails" asp-route-id="@item.PharmacyId" class="btn btn-sm btn-info">
                        <i class="fas fa-info-circle"></i> Details
                    </a>
                    <a asp-action="DeletePharmacy" asp-route-id="@item.PharmacyId" class="btn btn-sm btn-danger">
                        <i class="fas fa-trash-alt"></i> Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
    <a asp-action="Manager" a class="btn btn-primary">
        <i class="fas fa-arrow-left"></i>Back
    </a>
