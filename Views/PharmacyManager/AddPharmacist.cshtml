@model PrescribingSystem.Models.Pharmacist

@{
    ViewData["Title"] = "Create Pharmacist";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<h1 class="text-center mb-4">Create Pharmacist</h1>

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow p-4" style="width: 100%; max-width: 600px; border: 1px solid #dee2e6;">
        <form asp-action="AddPharmacist" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label fw-bold"></label>
                <input asp-for="Name" class="form-control rounded" style="height: 45px;" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Surname" class="form-label fw-bold"></label>
                <input asp-for="Surname" class="form-control rounded" style="height: 45px;" />
                <span asp-validation-for="Surname" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Cellphone" class="form-label fw-bold"></label>
                <input asp-for="Cellphone" class="form-control rounded" style="height: 45px;" />
                <span asp-validation-for="Cellphone" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label fw-bold"></label>
                <input asp-for="Email" class="form-control rounded" style="height: 45px;" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="HealthCouncil" class="form-label fw-bold"></label>
                <input asp-for="HealthCouncil" class="form-control rounded" style="height: 45px;" />
                <span asp-validation-for="HealthCouncil" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="RegistrationNumber" class="form-label fw-bold"></label>
                <input asp-for="RegistrationNumber" class="form-control rounded" style="height: 45px;" />
                <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Save
                </button>
                <a asp-action="IndexPharmacist" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            </div>
        </form>
    </div>
</div>
