@model IEnumerable<PrescribingSystem.Models.DorsageForm>

@{
    ViewData["Title"] = "Dorsage Forms";
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

<div class="container mt-5">
    <div class="border p-4 rounded shadow bg-light">
        <h2 class="text-center mb-4 text-primary">Dorsage Forms</h2>

        <div class="text-center mb-3">
            <a asp-action="Manager" class="btn btn-secondary me-2">
                <i class="fas fa-home"></i> Home
            </a>
            <a asp-action="AddDorsageForm" class="btn btn-success">
                <i class="fas fa-plus"></i> New Dorsage
            </a>
        </div>

        <table class="table table-dark table-bordered table-striped">
            <thead>
                <tr>
                    <th style="width: 80%;">Name</th>
                    <th class="text-center" style="width: 20%;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.DorsageFormName</td>
                        <td class="text-center">
                            <div class="btn-group">
                                <a asp-action="DorsageFormEdit" asp-route-id="@item.DorsageFormId" class="btn btn-sm btn-primary me-1">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a asp-action="DeleteDorsage" asp-route-id="@item.DorsageFormId" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
