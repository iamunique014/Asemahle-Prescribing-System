@model PrescribingSystem.Models.ViewModels.MedicationViewModel

@{
    ViewData["Title"] = "Create Medication";
}

<h2>Create Medication</h2>

<form asp-action="AddMedication" method="post">
    <div class="form-group">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Schedule" class="control-label"></label>
        <input asp-for="Schedule" class="form-control" />
        <span asp-validation-for="Schedule" class="text-danger"></span>
    </div>
   
    <div class="form-group">
        <label asp-for="CurrentSalesPrice" class="control-label"></label>
        <input asp-for="CurrentSalesPrice" class="form-control" />
        <span asp-validation-for="CurrentSalesPrice" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DorsageFormId" class="control-label"></label>
        <select asp-for="DorsageFormId" class="form-control" asp-items="ViewBag.DosageFormId">
            <option value="">-- Select Dosage Form --</option>
        </select>
        <span asp-validation-for="DorsageFormId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="SupplierId" class="control-label"></label>
        <select asp-for="SupplierId" class="form-control" asp-items="ViewBag.SupplierId">
            <option value="">-- Select Supplier --</option>
        </select>
        <span asp-validation-for="SupplierId" class="text-danger"></span>
    </div>
   @*  <div class="form-group">
        <label asp-for="DorsageFormId" class="control-label"></label>
        <select asp-for="DorsageFormId" class="form-control" asp-items="Model.DosageForms">
            <option value="">-- Select Dosage Form --</option>
        </select>
        <span asp-validation-for="DorsageFormId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="SupplierId" class="control-label"></label>
        <select asp-for="SupplierId" class="form-control" asp-items="Model.Suppliers">
            <option value="">-- Select Supplier --</option>
        </select>
        <span asp-validation-for="SupplierId" class="text-danger"></span>
    </div> *@

    <div class="form-group">
        <label asp-for="ReOrderLevel" class="control-label"></label>
        <input asp-for="ReOrderLevel" class="form-control" />
        <span asp-validation-for="ReOrderLevel" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="QuantityOnHand" class="control-label"></label>
        <input asp-for="QuantityOnHand" class="form-control" />
        <span asp-validation-for="QuantityOnHand" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Status" class="control-label"></label>
        <input asp-for="Status" class="form-check-input" type="checkbox" />
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Create</button>
    <a asp-action="IndexMedication" class="btn btn-secondary">Back</a>
</form>