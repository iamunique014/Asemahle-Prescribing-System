@model CustomerAllergy

@{
    ViewData["Title"] = "Delete Customer Allergy";
}

<h2>@ViewData["Title"]</h2>
<h3>Are you sure you want to delete this?</h3>
<dl class="row">
    <dt class="col-sm-2">Customer</dt>
    <dd class="col-sm-10">@Model.Customer.Name @Model.Customer.Surname</dd>
    <dt class="col-sm-2">Active Ingredient</dt>
    <dd class="col-sm-10">@Model.ActiveIngredients.ActiveIngredientName</dd>
</dl>
<form asp-action="DeleteConfirmed">
    <input type="hidden" asp-for="CustomerAllergyId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
