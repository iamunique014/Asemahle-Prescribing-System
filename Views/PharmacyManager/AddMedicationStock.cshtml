@model PrescribingSystem.Models.ViewModels.StockOrderCreateViewModel



@{
    ViewData["Title"] = "Medication Records & Order";
}

<h1 class="mb-4">Medication Records & Place Stock Order</h1>

<!-- Actions -->
<div class="mb-3 d-flex gap-2">
 @*    <a asp-action="AddMedication" class="btn btn-success">
        <i class="fas fa-plus"></i> Add Medication
    </a> *@
    <a asp-action="Manager" class="btn btn-primary">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>

<!-- Medication Records Table -->
<section class="mb-5">
    <div class="card">
        <div class="card-header bg-dark text-white">
            <strong>Existing Medications</strong>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-bordered m-0">
                <thead class="thead-dark">
                    <tr>
                        <th>Name</th>
                        <th>Re-order Level</th>
                        <th>Quantity on Hand</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Medications)
                    {
                        var isLowStock = item.QuantityOnHand <= item.ReOrderLevel;
                        var rowClass = isLowStock ? "table-danger" : "";
                        <tr class="@rowClass">
                            <td>@item.Name</td>
                            <td>@item.ReOrderLevel</td>
                            <td>
                                @item.QuantityOnHand
                                @if (isLowStock)
                                {
                                    <span class="badge bg-danger ms-2" title="Needs reordering">Low Stock</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- Place Stock Order Form -->
<section>
    <form asp-action="AddMedicationStock" method="post">
        <!-- Hidden Stock Order ID -->
        <input type="hidden" asp-for="OrderNumber" />

        <div class="form-group">
            <label asp-for="StockOrderId" class="form-label">Select Stock</label>
            <select asp-for="StockOrderId" asp-items="ViewBag.StockOrderId" class="form-control">
                <option value="">-- Select Stock --</option>
            </select>
            <span asp-validation-for="StockOrderId" class="text-danger"></span>
        </div>


        <div class="row">
            <!-- Available Medications -->
            <div class="col-md-6 mb-3">
                <div class="card h-100">
                    <div class="card-header bg-info text-white">
                        <strong>Select Medications</strong>
                    </div>
                    <div class="card-body" style="max-height: 300px; overflow-y: auto;">
                        @foreach (var med in Model.Medications)
                        {
                            <div class="form-row d-flex align-items-center mb-2">
                                <div class="form-check mr-2">
                                    <input type="checkbox" class="form-check-input medication-checkbox"
                                           id="med_@med.MedicationId"
                                           value="@med.MedicationId"
                                           data-med-id="@med.MedicationId"
                                           data-med-name="@med.Name"
                                           name="SelectedMedicationIds[]" />

                                    <label class="form-check-label" for="med_@med.MedicationId">@med.Name</label>
                                </div>
                                <div class="ml-3 quantity-wrapper" style="display: none;">
                                    <input type="number"
                                           class="form-control form-control-sm quantity-input"
                                           name="Quantity[@med.MedicationId]"
                                           placeholder="Qty"
                                           min="1"
                                           disabled />
                                    <span class="text-danger quantity-error" style="display:none;">Required</span>
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>

            <!-- Summary Table -->
            <div class="col-md-6 mb-3">
                <div class="card h-100">
                    <div class="card-header bg-secondary text-white">
                        <strong>Selected Medications Summary</strong>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-bordered m-0">
                            <thead class="thead-light">
                                <tr>
                                    <th>Medication</th>
                                    <th>Quantity</th>
                                </tr>
                            </thead>
                            <tbody id="medicationSummaryTableBody">
                                <!-- JavaScript will populate this -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Form Actions -->
        <div class="form-group mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Place Order</button>
            <a asp-action="IndexStockOrder" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const checkboxes = document.querySelectorAll('.medication-checkbox');

            checkboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function () {
                    const medId = this.dataset.medId;
                    const quantityWrapper = this.closest('.form-row').querySelector('.quantity-wrapper');
                    const quantityInput = quantityWrapper.querySelector('.quantity-input');
                    const summaryTable = document.getElementById('medicationSummaryTableBody');

                    if (this.checked) {
                        quantityWrapper.style.display = 'block';
                        quantityInput.disabled = false;

                        // Add to summary
                        const row = document.createElement('tr');
                        row.setAttribute('data-med-id', medId);
                        row.innerHTML = `
                            <td>${this.dataset.medName}</td>
                            <td class="summary-quantity">${quantityInput.value || '1'}</td>
                        `;
                        summaryTable.appendChild(row);

                        // Update summary on quantity change
                        quantityInput.addEventListener('input', function () {
                            const summaryRow = summaryTable.querySelector(`tr[data-med-id="${medId}"] .summary-quantity`);
                            if (summaryRow) {
                                summaryRow.textContent = this.value;
                            }
                        });

                    } else {
                        quantityWrapper.style.display = 'none';
                        quantityInput.disabled = true;
                        quantityInput.value = '';

                        // Remove from summary
                        const existingRow = summaryTable.querySelector(`tr[data-med-id="${medId}"]`);
                        if (existingRow) summaryTable.removeChild(existingRow);
                    }
                });
            });
        });
    </script>
}

