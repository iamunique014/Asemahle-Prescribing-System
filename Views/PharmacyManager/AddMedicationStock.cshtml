@model PrescribingSystem.Models.ViewModels.StockOrderCreateViewModel

@{
    ViewData["Title"] = "Create Stock Order Item";
    var orderCount = ViewBag.StockOrderCount ?? 0;
}

<style>
    .info-button-container {
        position: relative;
    }

    .info-button {
        position: absolute;
        top: 0;
        right: 40px;
        margin: 10px;
        cursor: pointer;
        color: #007bff;
        border: none;
        background: none;
        font-size: 1.2rem;
    }

    .info-tooltip {
        display: none;
        position: absolute;
        top: 40px;
        right: 10px;
        background-color: #f8f9fa;
        color: #212529;
        border: 1px solid #ced4da;
        border-radius: 5px;
        padding: 10px;
        width: 250px;
        z-index: 1000;
    }

    .info-button:hover + .info-tooltip {
        display: block;
    }

    .order-icon {
        position: absolute;
        top: 0;
        right: 80px;
        margin: 10px;
        font-size: 1.4rem;
        color: green;
        cursor: default;
    }

    .order-count {
        background-color: red;
        color: white;
        font-size: 0.75rem;
        border-radius: 50%;
        padding: 3px 7px;
        margin-left: 5px;
    }
</style>

<div class="info-button-container">
    <div class="order-icon">
        &#128230; <!-- Box icon -->
        <span class="order-count">@orderCount</span>
    </div>

    <button type="button" class="info-button" title="Info">&#9432;</button>
    <div class="info-tooltip">
        Use this form to add medications to a stock order. <br />
        - Select a stock order from the list.<br />
        - Choose one or more medications.<br />
        - Enter the total quantity (applies to all selected medications).<br />
        Click "Save" to complete the operation.
    </div>
</div>

<h2>Create Stock Order Item</h2>

<form asp-action="AddMedicationStock" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="StockOrderId" class="control-label"></label>
        <select asp-for="StockOrderId" class="form-control" asp-items="ViewBag.StockOrderId"></select>
        <span asp-validation-for="StockOrderId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="SelectedMedicationIds" class="control-label"></label>
        <select asp-for="SelectedMedicationIds" class="form-control" asp-items="ViewBag.MedicationId" multiple="multiple" size="5"></select>
        <span asp-validation-for="SelectedMedicationIds" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Quantity" class="control-label"></label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="IndexStockOrder" class="btn btn-secondary">Back to List</a>
</form>

