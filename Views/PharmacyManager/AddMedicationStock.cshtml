@model PrescribingSystem.Models.ViewModels.StockOrderCreateViewModel

@{
    ViewData["Title"] = "Medication Records & Order";
}

<h1 class="mb-4">Medication Records & Place Stock Order</h1>

<!-- Actions -->
<div class="mb-3 d-flex gap-2">
    <a asp-action="Manager" class="btn btn-primary">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>

<!-- Medication Records Table with Selection -->
<section class="mb-5">
    <form asp-action="AddMedicationStock" method="post">
        <!-- Supplier Selection -->
        @* <div class="form-group">
            <label asp-for="SupplierId" class="form-label">Select Supplier</label>
            <select asp-for="SupplierId" class="form-control" asp-items="@(ViewBag.SupplierList as List<SelectListItem>)">
                <option value="">-- Select Supplier --</option>
            </select>
            <span asp-validation-for="SupplierId" class="text-danger"></span>
        </div> *@

        <!-- Order Number -->
        <input type="hidden" asp-for="OrderNumber" />
        <div class="form-group">
            <label asp-for="OrderNumber" class="form-label">Order Number</label>
            <input asp-for="OrderNumber" class="form-control" readonly />
        </div>

        <div class="card">
            <div class="card-header bg-dark text-white">
                <strong>Existing Medications (Select for Stock Order)</strong>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-bordered m-0">
                    <thead class="thead-dark">
                        <tr>
                            <th>Select</th>
                            <th>Name</th>
                            <th>Re-order Level</th>
                            <th>Quantity on Hand</th>
                            <th>Order Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Medications)
                        {
                            var isLowStock = item.QuantityOnHand <= item.ReOrderLevel;
                            var rowClass = isLowStock ? "table-danger" : "";
                            <tr class="@rowClass">
                                <td>
                                    <input type="checkbox"
                                           class="form-check-input medication-checkbox"
                                           id="med_@item.MedicationId"
                                           value="@item.MedicationId"
                                           data-med-id="@item.MedicationId"
                                           data-med-name="@item.Name"
                                           name="SelectedMedicationIds[]" />
                                </td>
                                <td>
                                    <label for="med_@item.MedicationId">@item.Name</label>
                                </td>
                                <td>@item.ReOrderLevel</td>
                                <td>
                                    @item.QuantityOnHand
                                    @if (isLowStock)
                                    {
                                        <span class="badge bg-danger ms-2" title="Needs reordering">Low Stock</span>
                                    }
                                </td>
                                <td>
                                    <input type="number"
                                           class="form-control form-control-sm quantity-input"
                                           name="Quantity[@item.MedicationId]"
                                           placeholder="Qty"
                                           min="1"
                                           value="1"
                                           disabled />
                                    <span class="text-danger quantity-error" style="display:none;">Required</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Summary -->
        <div class="card mt-3">
            <div class="card-header bg-secondary text-white">
                <strong>Selected Medications Summary</strong>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered m-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Medication</th>
                            <th>Quantity</th>
                        </tr>
                    </thead>
                    <tbody id="medicationSummaryTableBody">
                        <!-- JavaScript will populate this -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Form Buttons -->
        <form asp-action="ConfirmMedicationStock" method="post">
            <!-- Selection Form -->
            <button type="submit" class="btn btn-success">Next: Confirm</button>
        </form>

        <div class="form-group mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Place Order</button>
            <a asp-action="IndexStockOrder" class="btn btn-secondary">Back to List</a>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const checkboxes = document.querySelectorAll('.medication-checkbox');
            const summaryTable = document.getElementById('medicationSummaryTableBody');

            checkboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function () {
                    const medId = this.dataset.medId;
                    const medName = this.dataset.medName;
                    const row = this.closest('tr');
                    const quantityInput = row.querySelector('.quantity-input');

                    if (this.checked) {
                        quantityInput.disabled = false;
                        quantityInput.value = quantityInput.value || 1;

                        const existingSummaryRow = summaryTable.querySelector(`tr[data-med-id="${medId}"]`);
                        if (!existingSummaryRow) {
                            const summaryRow = document.createElement('tr');
                            summaryRow.setAttribute('data-med-id', medId);
                            summaryRow.innerHTML = `
                                <td>${medName}</td>
                                <td class="summary-quantity">${quantityInput.value}</td>
                            `;
                            summaryTable.appendChild(summaryRow);
                        }

                        quantityInput.addEventListener('input', function () {
                            const summaryCell = summaryTable.querySelector(`tr[data-med-id="${medId}"] .summary-quantity`);
                            if (summaryCell) {
                                summaryCell.textContent = this.value;
                            }
                        });

                    } else {
                        quantityInput.disabled = true;
                        quantityInput.value = '';

                        const summaryRow = summaryTable.querySelector(`tr[data-med-id="${medId}"]`);
                        if (summaryRow) {
                            summaryTable.removeChild(summaryRow);
                        }
                    }
                });
            });
        });
    </script>
}
