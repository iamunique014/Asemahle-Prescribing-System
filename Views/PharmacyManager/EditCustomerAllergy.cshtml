@model PrescribingSystem.Models.CustomerAllergy
@{
    ViewData["Title"] = "Edit Customer Allergy";
}

<h2>Edit Customer Allergy</h2>

<form method="post">
    <input type="hidden" asp-for="CustomerAllergyId" />

    <div class="form-group">
        <label asp-for="CustomerId" class="control-label"></label>
        <select asp-for="CustomerId" class="form-control" asp-items="ViewBag.CustomerId"></select>
        <span asp-validation-for="CustomerId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ActiveIngredientId" class="control-label"></label>
        <select asp-for="ActiveIngredientId" class="form-control" asp-items="ViewBag.ActiveIngredientId"></select>
        <span asp-validation-for="ActiveIngredientId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
