@model PrescribingSystem.Models.MedicationStockOrder

<h2>Medication Stock Order Details</h2>

<div>
    <h4>Order ID: @Model.MedicationStockOrderId</h4>
    <dl class="row">
        <dt class="col-sm-2">Medication</dt>
        <dd class="col-sm-10">@Model.Medication?.Name</dd>

        <dt class="col-sm-2">Stock Order</dt>
        <dd class="col-sm-10">@Model.StockOrder?.StockOrderId</dd>

        <dt class="col-sm-2">Quantity</dt>
        <dd class="col-sm-10">@Model.Quantity</dd>
    </dl>
</div>
<a asp-action="Edit" asp-route-id="@Model.MedicationStockOrderId">Edit</a> |
<a asp-action="Index">Back to List</a>
