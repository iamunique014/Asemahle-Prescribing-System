@model PrescribingSystem.Models.Supplier

@{
    ViewData["Title"] = "Delete Medication Supplier";
}

<h2>Delete Medication Supplier</h2>

<h4>Are you sure you want to delete this?</h4>
<div>
    <h5>@Model.SupplierName</h5>
    <dl class="row">
        <dt class="col-sm-2">Contact Person</dt>
        <dd class="col-sm-10">@Model.ContactPerson</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="SupplierId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="IndexSupplier" class="btn btn-secondary">Cancel</a>
    </form>
</div>
