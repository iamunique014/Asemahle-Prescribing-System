@model PrescribingSystem.Models.Supplier

@{
    ViewData["Title"] = "Delete Medication Supplier";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Delete Medication Supplier</h4>
                </div>

                <div class="card-body">
                    <h5 class="text-danger">Are you sure you want to delete this supplier?</h5>
                    <hr />
                    <dl class="row">
                        <dt class="col-sm-4">Supplier Name</dt>
                        <dd class="col-sm-8">@Model.SupplierName</dd>

                        <dt class="col-sm-4">Contact Person</dt>
                        <dd class="col-sm-8">@Model.ContactPerson</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>
                    </dl>
                </div>

                <div class="card-footer d-flex justify-content-between">
                    <form asp-action="DeleteSupplier" method="post" class="mb-0">
                        <input type="hidden" asp-for="SupplierId" />
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                    <a asp-action="IndexSupplier" class="btn btn-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</div>
