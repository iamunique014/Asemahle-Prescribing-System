@model IEnumerable<PrescribingSystem.Models.StockOrder>

@{
    ViewData["Title"] = "Stock Orders";
}

<h2>Stock Orders</h2>

@* <p>
    <a asp-action="AddStock" class="btn btn-primary">Create New Order</a>
</p>
 *@
<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th>Order Number</th>
            <th>Supplier</th>
            <th>Order Date</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.OrderNumber</td>
                <td>@order.Supplier?.SupplierName</td>
                <td>@order.OrderDate.ToShortDateString()</td>
                <td>@(order.Status ? "Completed" : "Pending")</td>
                <td>
                    <a asp-action="EditStock" asp-route-id="@order.StockOrderId" class="btn btn-primary btn-sm">Edit</a>
                    <a asp-action="StockDetails" asp-route-id="@order.StockOrderId" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="DeleteStock" asp-route-id="@order.StockOrderId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
    <div>
        <a asp-action="AddStock" class="btn btn-success">
            <i class="fas fa-user"></i> Create New Order
        </a>
        <a asp-action="Manager" class="btn btn-primary">
            <i class="fas fa-arrow-left"></i> Back
        </a>
    </div>
</table>
