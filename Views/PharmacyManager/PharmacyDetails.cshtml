@model PrescribingSystem.Models.Pharmacy

@{
    ViewData["Title"] = "Pharmacy Details";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fas fa-prescription-bottle-alt"></i> Pharmacy Details</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4 fw-semibold">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4 fw-semibold">Health Council Registration Number</dt>
                <dd class="col-sm-8">@Model.HealthCouncilRegistrationNumber</dd>

                <dt class="col-sm-4 fw-semibold">Physical Address 1</dt>
                <dd class="col-sm-8">@Model.PhysicalAddress1</dd>

                <dt class="col-sm-4 fw-semibold">Physical Address 2</dt>
                <dd class="col-sm-8">@Model.PhysicalAddress2</dd>

                <dt class="col-sm-4 fw-semibold">Contact Number</dt>
                <dd class="col-sm-8">@Model.ContactNumber</dd>

                <dt class="col-sm-4 fw-semibold">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4 fw-semibold">Website URL</dt>
                <dd class="col-sm-8">
                    <a href="@Model.WebsiteUrl" target="_blank">@Model.WebsiteUrl</a>
                </dd>

                <dt class="col-sm-4 fw-semibold">Responsible Pharmacist</dt>
                <dd class="col-sm-8">
                    @* Replace this with actual pharmacist name if available *@
                    @Model.PharmacistId
                </dd>
            </dl>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="EditPharmacy" asp-route-id="@Model.PharmacyId" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Edit
                </a>
                <a asp-action="IndexPharmacy" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>
