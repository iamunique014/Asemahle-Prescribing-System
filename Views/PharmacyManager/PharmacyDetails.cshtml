@model PrescribingSystem.Models.Pharmacy

@{
    ViewData["Title"] = "Pharmacy Details";
}

<h1>Pharmacy Details</h1>

<div>
    <dl class="row">
        <dt class="col-sm-4">Name</dt>
        <dd class="col-sm-8">@Model.Name</dd>

        <dt class="col-sm-4">Health Council Registration Number</dt>
        <dd class="col-sm-8">@Model.HealthCouncilRegistrationNumber</dd>

        <dt class="col-sm-4">Physical Address 1</dt>
        <dd class="col-sm-8">@Model.PhysicalAddress1</dd>

        <dt class="col-sm-4">Physical Address 2</dt>
        <dd class="col-sm-8">@Model.PhysicalAddress2</dd>

        <dt class="col-sm-4">Contact Number</dt>
        <dd class="col-sm-8">@Model.ContactNumber</dd>

        <dt class="col-sm-4">Email</dt>
        <dd class="col-sm-8">@Model.Email</dd>

        <dt class="col-sm-4">Website URL</dt>
        <dd class="col-sm-8">@Model.WebsiteUrl</dd>

        <dt class="col-sm-4">Responsible Pharmacist</dt>
        <dd class="col-sm-8">@Model.PharmacistId</dd> <!-- Replace with pharmacist name if needed -->
    </dl>
</div>

<a asp-action="EditPharmacy" asp-route-id="@Model.PharmacyId" class="btn btn-primary">Edit</a>
<a asp-action="IndexPharmacy" class="btn btn-secondary">Back to List</a>
