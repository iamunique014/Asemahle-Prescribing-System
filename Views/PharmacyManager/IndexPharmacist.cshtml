@model IEnumerable<PrescribingSystem.Models.Pharmacist>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

@{
    ViewData["Title"] = "Pharmacists";
}

<h1 class="mb-4">Pharmacists</h1>

<div class="mb-3">
    <a asp-action="AddPharmacist" class="btn btn-success me-2">
        <i class="fas fa-user-plus"></i> Add Pharmacist
    </a>
    <a asp-action="Manager" class="btn btn-primary">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-dark table-striped">
        <thead class="table-light text-dark">
            <tr>
                <th>Name</th>
                <th>Surname</th>
                <th>Cellphone</th>
                <th>Email</th>
                <th>Health Council</th>
                <th>Registration #</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Surname</td>
                    <td>@item.Cellphone</td>
                    <td>@item.Email</td>
                    <td>@item.HealthCouncil</td>
                    <td>@item.RegistrationNumber</td>
                    <td>
                        <div class="btn-group" role="group" aria-label="Pharmacist Actions">
                            <a asp-action="EditPharmacist" asp-route-id="@item.PharmacistId" class="btn btn-primary btn-sm">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a asp-action="DetailsPharmacist" asp-route-id="@item.PharmacistId" class="btn btn-info btn-sm">
                                <i class="fas fa-info-circle"></i> Details
                            </a>
                            <a asp-action="DeletePharmacist" asp-route-id="@item.PharmacistId" class="btn btn-warning btn-sm">
                                <i class="fas fa-trash-alt"></i> Delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
