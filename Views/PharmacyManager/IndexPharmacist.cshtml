@model IEnumerable<PrescribingSystem.Models.Pharmacist>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />


@{
    ViewData["Title"] = "Pharmacists";
}

<h1>Pharmacists</h1>
@* <p>
    <a asp-action="AddPharmacist">Create New</a>
</p>
 *@
<table class="table table-dark table-striped">
    <div class="btn-group" role="group" aria-label="Basic mixed styles example">
        <a asp-action="AddPharmacist" class="btn btn-success">
            <i class="fas fa-user"></i> Add Pharmacist
        </a>

        </div>
    <thead>
        <tr>
            <th>Name</th>
            <th>Surname</th>
            <th>Cellphone</th>
            <th>Email</th>
            <th>Health Council</th>
            <th>Registration #</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Surname</td>
                <td>@item.Cellphone</td>
                <td>@item.Email</td>
                <td>@item.HealthCouncil</td>
                <td>@item.RegistrationNumber</td>
                <td>
                    <div class="btn-group" role="group" aria-label="Doctor Actions">
                        <a asp-action="EditPharmacist" asp-route-id="@item.PharmacistId" class="btn btn-primary">Edit</a> 
                        <a asp-action="DetailsPharmacist" asp-route-id="@item.PharmacistId" class="btn btn-outline-light">Details</a> 
                        <a asp-action="DeletePharmacist" asp-route-id="@item.PharmacistId" class="btn btn-warning">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>