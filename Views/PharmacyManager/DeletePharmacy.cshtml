@model PrescribingSystem.Models.Pharmacy

@{
    ViewData["Title"] = "Delete Pharmacy";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

<div class="container mt-5">
    <div class="card shadow border-0">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0"><i class="fas fa-trash-alt"></i> Confirm Delete</h4>
        </div>
        <div class="card-body">
            <p class="text-danger fw-bold">Are you sure you want to delete this pharmacy?</p>
            <dl class="row">
                <dt class="col-sm-4 fw-semibold">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4 fw-semibold">Health Council Registration Number</dt>
                <dd class="col-sm-8">@Model.HealthCouncilRegistrationNumber</dd>

                <dt class="col-sm-4 fw-semibold">Physical Address 1</dt>
                <dd class="col-sm-8">@Model.PhysicalAddress1</dd>

                <dt class="col-sm-4 fw-semibold">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>
            </dl>

            <form asp-action="DeletePharmacy" method="post" class="d-inline">
                <input type="hidden" asp-for="PharmacyId" />
                <button type="submit" class="btn btn-danger me-2">
                    <i class="fas fa-trash"></i> Delete
                </button>
            </form>

            <a asp-action="IndexPharmacy" class="btn btn-secondary me-2">
                <i class="fas fa-times"></i> Cancel
            </a>

            <a asp-action="IndexPharmacy" class="btn btn-primary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>
</div>
