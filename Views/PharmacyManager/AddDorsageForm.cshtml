@model PrescribingSystem.Models.DorsageForm

@{
    ViewData["Title"] = "Add Dorsage Form";
}

<div class="container d-flex justify-content-center align-items-center mt-5">
    <div class="border rounded p-4 shadow bg-light" style="width: 400px;">
        <h3 class="text-center mb-4">Add Dorsage Form</h3>

        <form asp-action="AddDorsageForm" onsubmit="return showSavePopup()">
            <div class="form-group mb-3">
                <label asp-for="DorsageFormName" class="form-label"></label>
                <input asp-for="DorsageFormName" class="form-control" style="max-width: 300px;" />
                <span asp-validation-for="DorsageFormName" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-success">Save</button>
                <a asp-action="IndexDorsageForm" class="btn btn-secondary">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function showSavePopup() {
            alert('Dorsage Form saved successfully!');
            return true; // continue form submission
        }
    </script>
}
