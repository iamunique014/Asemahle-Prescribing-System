@model PrescribingSystem.Models.Pharmacy

@{
    ViewData["Title"] = "Edit Pharmacy";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-prescription-bottle-alt"></i> Edit Pharmacy</h4>
                </div>
                <div class="card-body">
                    <form asp-action="EditPharmacy">
                        <input type="hidden" asp-for="PharmacyId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="HealthCouncilRegistrationNumber" class="form-label"></label>
                            <input asp-for="HealthCouncilRegistrationNumber" class="form-control" />
                            <span asp-validation-for="HealthCouncilRegistrationNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhysicalAddress1" class="form-label"></label>
                            <input asp-for="PhysicalAddress1" class="form-control" />
                            <span asp-validation-for="PhysicalAddress1" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhysicalAddress2" class="form-label"></label>
                            <input asp-for="PhysicalAddress2" class="form-control" />
                            <span asp-validation-for="PhysicalAddress2" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ContactNumber" class="form-label"></label>
                            <input asp-for="ContactNumber" class="form-control" />
                            <span asp-validation-for="ContactNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="WebsiteUrl" class="form-label"></label>
                            <input asp-for="WebsiteUrl" class="form-control" />
                            <span asp-validation-for="WebsiteUrl" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="PharmacistId" class="form-label"></label>
                            <select asp-for="PharmacistId" class="form-select" asp-items="ViewBag.Pharmacist"></select>
                            <span asp-validation-for="PharmacistId" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Save Changes
                            </button>
                            <a asp-action="IndexPharmacy" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
