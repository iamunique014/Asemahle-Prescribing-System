@model PrescribingSystem.Models.Supplier

@{
    ViewData["Title"] = "Supplier Details";
}

<h2>Medication Supplier Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">Supplier Name</dt>
        <dd class="col-sm-10">@Model.SupplierName</dd>

        <dt class="col-sm-2">Contact Person</dt>
        <dd class="col-sm-10">@Model.ContactPerson</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.SupplierId" class="btn btn-primary">Edit</a>
<a asp-action="IndexSupplier" class="btn btn-secondary">Back to List</a>
