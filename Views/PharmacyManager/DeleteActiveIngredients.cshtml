@model PrescribingSystem.Models.ActiveIngredients

@{
    ViewData["Title"] = "Delete Active Ingredient";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger text-white text-center">
                    <h3 class="mb-0">
                        <i class="fas fa-exclamation-triangle"></i> Confirm Deletion
                    </h3>
                </div>
                <div class="card-body">
                    <p class="text-center fs-5 text-danger fw-semibold">
                        Are you sure you want to delete this Active Ingredient?
                    </p>

                    <hr />

                    <dl class="row">
                        <dt class="col-sm-4 text-end fw-bold">
                            @Html.DisplayNameFor(model => model.ActiveIngredientName):
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.ActiveIngredientName)
                        </dd>
                    </dl>

                    <form asp-action="DeleteActiveIngredients">
                        <input type="hidden" asp-for="ActiveIngredientId" />

                        <div class="d-flex justify-content-center gap-3 mt-4">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash-alt"></i> Delete
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
