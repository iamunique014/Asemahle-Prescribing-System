@model IEnumerable<PrescribingSystem.Models.Medication>

@{
    ViewData["Title"] = "Medication List";
}

<h1>Medication Records</h1>


<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Schedule</th>
            <th>Dosage Form</th>
            <th>Sales Price</th>
            <th>Supplier</th>
            <th>Re-order Level</th>
            <th>Quantity on Hand</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Schedule</td>
                <td>@item.DorsageForm.DorsageFormName</td>
                <td>@item.CurrentSalesPrice.ToString("C")</td>
                <td>@item.Supplier.SupplierName</td>
                <td>@item.ReOrderLevel</td>
                <td>@item.QuantityOnHand</td>
                <td>@(item.Status ? "Active" : "Inactive")</td>
                <td>
                    <a asp-action="EditMedication" asp-route-id="@item.MedicationId" class="btn btn-primary btn-sm">Edit</a>
                    <a asp-action="MedicationDetails" asp-route-id="@item.MedicationId" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="DeleteMedication" asp-route-id="@item.MedicationId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
    <div>
        <a asp-action="AddMedication" class="btn btn-success">
            <i class="fas fa-user"></i> Add Medication
        </a>
        <a asp-action="Manager" class="btn btn-primary">
            <i class="fas fa-arrow-left"></i> Back
        </a>
    </div>
</table>
