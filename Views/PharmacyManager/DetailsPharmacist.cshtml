@model PrescribingSystem.Models.Pharmacist

@{
    ViewData["Title"] = "Pharmacist Details";
}

<h1>Pharmacist Details</h1>

<div>
    <h4>Pharmacist</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Surname</dt>
        <dd class="col-sm-10">@Model.Surname</dd>

        <dt class="col-sm-2">Cellphone</dt>
        <dd class="col-sm-10">@Model.Cellphone</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Health Council</dt>
        <dd class="col-sm-10">@Model.HealthCouncil</dd>

        <dt class="col-sm-2">Registration Number</dt>
        <dd class="col-sm-10">@Model.RegistrationNumber</dd>
    </dl>
</div>

<div>
    <a asp-action="IndexPharmacist" class="btn btn-secondary">Back to List</a>
</div>
