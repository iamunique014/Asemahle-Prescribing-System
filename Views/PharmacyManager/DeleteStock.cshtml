@model PrescribingSystem.Models.StockOrder

@{
    ViewData["Title"] = "Delete Stock Order";
}

<h2>Delete Confirmation</h2>

<div>
    <h4>Are you sure you want to delete this stock order?</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Order Number</dt>
        <dd class="col-sm-10">@Model.OrderNumber</dd>

        <dt class="col-sm-2">Supplier</dt>
        <dd class="col-sm-10">@Model.Supplier?.SupplierName</dd>

        <dt class="col-sm-2">Order Date</dt>
        <dd class="col-sm-10">@Model.OrderDate.ToShortDateString()</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@(Model.Status ? "Completed" : "Pending")</dd>
    </dl>

    <form asp-action="DeleteStock" method="post">
        <input type="hidden" asp-for="StockOrderId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="IndexStock" class="btn btn-secondary">Cancel</a>
    </form>
</div>
