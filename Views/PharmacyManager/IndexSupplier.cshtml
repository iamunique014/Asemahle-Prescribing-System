@model IEnumerable<PrescribingSystem.Models.Supplier>

@{
    ViewData["Title"] = "Medication Suppliers";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    .custom-input {
        width: 200px;
        height: 45px;
        padding: 6px 10px;
        font-size: 1rem;
        border-radius: 8px;
        border: 1px solid #ccc;
    }

    .table-container {
        border: 2px solid #343a40;
        border-radius: 12px;
        padding: 20px;
        background-color: #212529;
        color: white;
    }

    .action-buttons {
        margin-top: 20px;
    }

    h1 {
        margin-bottom: 25px;
    }
</style>

<h1>Medication Suppliers</h1>
<div class="action-buttons">
    <a asp-action="AddSupplier" class="btn btn-success me-2">
        <i class="fas fa-user-plus"></i> Add Medication Supplier
    </a>
    <a asp-action="Manager" class="btn btn-primary">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>
<div class="table-container">
    <table class="table table-bordered table-dark table-striped table-responsive">
        <thead class="table-light text-dark">
            <tr>
                <th>Supplier Name</th>
                <th>Contact Person</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.SupplierName</td>
                    <td>@item.ContactPerson</td>
                    <td>@item.Email</td>
                    <td>
                        <div class="btn-group" role="group" aria-label="Supplier Actions">
                            <a asp-action="SupplierEdit" asp-route-id="@item.SupplierId" class="btn btn-sm btn-primary">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a asp-action="SupplierDetails" asp-route-id="@item.SupplierId" class="btn btn-sm btn-info">
                                <i class="fas fa-info-circle"></i> Details
                            </a>
                            <a asp-action="DeleteSupplier" asp-route-id="@item.SupplierId" class="btn btn-sm btn-danger">
                                <i class="fas fa-trash-alt"></i> Delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


