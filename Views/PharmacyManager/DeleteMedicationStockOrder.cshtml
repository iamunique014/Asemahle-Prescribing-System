@model PrescribingSystem.Models.MedicationStockOrder

<h2>Delete Medication Stock Order</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Medication: @Model.Medication?.Name</h4>
    <h4>Quantity: @Model.Quantity</h4>
</div>

<form asp-action="DeleteMedicationStockOrder">
    <input type="hidden" asp-for="MedicationStockOrderId" />
    <button type="submit" class="btn btn-danger">Delete</button> |
    <a asp-action="IndexStockOrder">Cancel</a>
</form>
