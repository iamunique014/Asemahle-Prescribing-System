@model PrescribingSystem.Models.MedicationStockOrder

@{
    ViewData["Title"] = "Delete Medication Stock Order";
}

<div class="container mt-5">
    <div class="card border-danger">
        <div class="card-header bg-danger text-white">
            <h4>Confirm Delete</h4>
        </div>
        <div class="card-body">
            <p>Are you sure you want to delete this Medication from the Stock Order?</p>
            <dl class="row">
                <dt class="col-sm-4">Medication</dt>
                <dd class="col-sm-8">@Model.Medication?.Name</dd>

                <dt class="col-sm-4">Quantity</dt>
                <dd class="col-sm-8">@Model.Quantity</dd>

                <dt class="col-sm-4">Order Number</dt>
                <dd class="col-sm-8">@Model.OrderNumber</dd>
            </dl>

            <form asp-action="DeleteMedicationStockOrder" method="post">
                <input type="hidden" asp-for="MedicationStockOrderId" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
