@model IEnumerable<PrescribingSystem.Models.Doctor>

@{
    ViewData["Title"] = "Doctors";
}

<h2>Doctors</h2>
@* 
<p>
    <a asp-action="AddDoctor" class="btn btn-success">Create New Doctor</a>
</p> *@

<table class="table table-dark table-striped">
    <div class="btn-group" role="group" aria-label="Basic mixed styles example">
        <div class="text-center">
            <a asp-action="AddDoctor" class="btn btn-success">Create New Doctor</a>
        </div>
        <div class="text-center">
            <a asp-action="Manager" class="btn btn-dark">Back</a>
        </div>
    </div>

    <thead>
        <tr>
            <th>Name</th>
            <th>Surname</th>
            <th>Practice Number</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Surname</td>
                <td>@item.Practice_Number</td>
                <td>@item.Email</td>
                <td>
                    <div class="btn-group" role="group" aria-label="Doctor Actions">
                        <a asp-action="EditDoctor" asp-route-id="@item.DoctorId" class="btn btn-primary">Edit</a>
                        <a asp-action="DetailsDoctor" asp-route-id="@item.DoctorId" class="btn btn-outline-light">Details</a>
                        <a asp-action="DeleteDoctor" asp-route-id="@item.DoctorId" class="btn btn-warning">Delete</a>
                        </div>
                </td>
            </tr>
        }
    </tbody>
    <div class="mb-3">
        <a class="btn btn-success" asp-controller="PharmacyManager" asp-action="ExportDoctorsToExcel">Export to Excel</a>
        <a class="btn btn-danger" asp-controller="PharmacyManager" asp-action="ExportDoctorsToPdf">Export to PDF</a>
    </div>

</table>
