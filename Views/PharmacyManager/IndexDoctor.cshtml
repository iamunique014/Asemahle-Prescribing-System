@model IEnumerable<PrescribingSystem.Models.Doctor>

@{
    ViewData["Title"] = "Doctors";
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white text-center">
            <h3>@ViewData["Title"]</h3>
        </div>

        <div class="card-body">
            <div class="d-flex justify-content-between mb-4">
                <a asp-action="AddDoctor" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Add New Doctor
                </a>
                <a asp-action="Manager" class="btn btn-secondary">
                    <i class="bi bi-arrow-left-circle"></i> Back
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle text-center border">
                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Surname</th>
                            <th>Practice Number</th>
                            <th>Email</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Surname</td>
                                <td>@item.Practice_Number</td>
                                <td>@item.Email</td>
                                <td>
                                    <div class="btn-group">
                                        <a asp-action="EditDoctor" asp-route-id="@item.DoctorId" class="btn btn-sm btn-primary">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>
                                        <a asp-action="DetailsDoctor" asp-route-id="@item.DoctorId" class="btn btn-sm btn-info text-white">
                                            <i class="bi bi-info-circle"></i> Details
                                        </a>
                                        <a asp-action="DeleteDoctor" asp-route-id="@item.DoctorId" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-3">
                <a class="btn btn-outline-success" asp-controller="PharmacyManager" asp-action="ExportDoctorsToExcel">
                    <i class="bi bi-file-earmark-excel"></i> Export to Excel
                </a>
                <a class="btn btn-outline-danger" asp-controller="PharmacyManager" asp-action="ExportDoctorsToPdf">
                    <i class="bi bi-file-earmark-pdf"></i> Export to PDF
                </a>
            </div>
        </div>
    </div>
</div>
