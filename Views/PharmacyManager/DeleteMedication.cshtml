@model PrescribingSystem.Models.Medication

@{
    ViewData["Title"] = "Delete Medication";
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="card border-danger" style="width: 50rem;">
        <div class="card-header bg-danger text-white text-center">
            <h2>Delete Medication</h2>
        </div>
        <div class="card-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger text-center">
                    @TempData["Error"]
                </div>
            }

            <h4 class="text-center mb-4">Are you sure you want to delete this medication?</h4>

            <dl class="row">
                <dt class="col-sm-4 text-end">Name:</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

                <dt class="col-sm-4 text-end">Dosage Form:</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.DorsageForm.DorsageFormName)</dd>

                <dt class="col-sm-4 text-end">Supplier:</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Supplier.SupplierName)</dd>
            </dl>

            <form asp-action="DeleteMedication" method="post" class="text-center mt-4">
                <input type="hidden" asp-for="MedicationId" />
                <button type="submit" class="btn btn-danger me-2">Delete</button>
                <a asp-action="IndexMedication" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
