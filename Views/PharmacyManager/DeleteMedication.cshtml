@model PrescribingSystem.Models.Medication

@{
    ViewData["Title"] = "Delete Medication";
}

<h2>Delete Medication</h2>

<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>@Model.Name</h4>
    <dl class="row">
        <dt class="col-sm-2">Schedule</dt>
        <dd class="col-sm-10">@Model.Schedule</dd>

        <dt class="col-sm-2">Dosage Form</dt>
        <dd class="col-sm-10">@Model.DorsageFormId</dd>

        <dt class="col-sm-2">Supplier</dt>
        <dd class="col-sm-10">@Model.SupplierId</dd>
    </dl>

    <form asp-action="DeleteMedication">
        <input type="hidden" asp-for="MedicationId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="IndexMedication" class="btn btn-secondary">Cancel</a>
    </form>
</div>
