@model PrescribingSystem.Models.Pharmacy

@{
    ViewData["Title"] = "Create Pharmacy";
}

<h1>Create Pharmacy</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="CreatePharmacy" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="HealthCouncilRegistrationNumber" class="control-label"></label>
                <input asp-for="HealthCouncilRegistrationNumber" class="form-control" />
                <span asp-validation-for="HealthCouncilRegistrationNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PhysicalAddress1" class="control-label"></label>
                <input asp-for="PhysicalAddress1" class="form-control" />
                <span asp-validation-for="PhysicalAddress1" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PhysicalAddress2" class="control-label"></label>
                <input asp-for="PhysicalAddress2" class="form-control" />
                <span asp-validation-for="PhysicalAddress2" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ContactNumber" class="control-label"></label>
                <input asp-for="ContactNumber" class="form-control" />
                <span asp-validation-for="ContactNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="WebsiteUrl" class="control-label"></label>
                <input asp-for="WebsiteUrl" class="form-control" />
                <span asp-validation-for="WebsiteUrl" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PharmacistId" class="control-label"></label>
                <select asp-for="PharmacistId" class="form-control" asp-items="ViewBag.Pharmacist"></select>
                <span asp-validation-for="PharmacistId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
        </form>
    </div>
</div>
<div>
    <a asp-action="IndexPharmacy" class="btn btn-secondary">Back to List</a>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
