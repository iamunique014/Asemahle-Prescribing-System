@model PrescribingSystem.Models.ActiveIngredients

@{
    ViewData["Title"] = "Active Ingredient Details";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-info-circle"></i> Active Ingredient Details</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4 text-end fw-semibold">
                            @Html.DisplayNameFor(model => model.ActiveIngredientName):
                        </dt>
                        <dd class="col-sm-8">
                            @Html.DisplayFor(model => model.ActiveIngredientName)
                        </dd>
                    </dl>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Edit" asp-route-id="@Model?.ActiveIngredientId" class="btn btn-primary">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <a asp-action="Index" class="btn btn-warning">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
