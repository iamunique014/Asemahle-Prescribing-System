@model PrescribingSystem.Models.Doctor

@{
    ViewData["Title"] = "Delete Doctor";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="text-center text-danger mb-4">Delete Doctor</h2>


            <table class="table table-dark table-striped">
                <tbody>
                    <tr>
                        <th>Name</th>
                        <td>@Model.Name</td>
                    </tr>
                    <tr>
                        <th>Surname</th>
                        <td>@Model.Surname</td>
                    </tr>
                    <tr>
                        <th>Practice Number</th>
                        <td>@Model.Practice_Number</td>
                    </tr>
                    <tr>
                        <th>Email</th>
                        <td>@Model.Email</td>
                    </tr>
                </tbody>
            </table>

            <form asp-action="DeleteDoctor" method="post" onsubmit="return confirmDelete();">
                <input type="hidden" asp-for="DoctorId" />
                <div class="text-center mt-4">
                    <input type="submit" value="Delete" class="btn btn-danger" />
                    <a asp-action="IndexDoctor" class="btn btn-secondary ms-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete() {
            return confirm("Are you sure you want to delete this doctor?");
        }
    </script>
}
