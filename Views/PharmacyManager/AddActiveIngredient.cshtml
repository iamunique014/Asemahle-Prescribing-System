@model PrescribingSystem.Models.ActiveIngredients

@{
    ViewData["Title"] = "Add Active Ingredient";
}

<h1>@ViewData["Title"]</h1>

<h4>Active Ingredient Details</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AddActiveIngredient">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ActiveIngredientName" class="control-label"></label>
                <input asp-for="ActiveIngredientName" class="form-control" />
                <span asp-validation-for="ActiveIngredientName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
