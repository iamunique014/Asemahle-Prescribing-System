@model PrescribingSystem.Models.ActiveIngredients

@{
    ViewData["Title"] = "Delete Active Ingredient";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="text-center text-danger">Delete Active Ingredient</h2>
            <h4 class="text-center">Are you sure you want to delete this?</h4>
            <hr />

            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <th>Name</th>
                        <td>@Model.ActiveIngredientName</td>
                    </tr>
                </tbody>
            </table>

            <form asp-action="DeleteActiveIngredient" method="post" onsubmit="return confirm('Are you sure you want to delete this Active Ingredient?');">
                <input type="hidden" asp-for="ActiveIngredientId" />
                <div class="text-center">
                    <input type="submit" value="Delete" class="btn btn-danger" />
                    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
