@model PrescribingSystem.Models.DorsageForm

@{
    ViewData["Title"] = "Delete Dorsage Form";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="border rounded shadow p-4 bg-light">
                <h3 class="text-center text-danger mb-4">Delete Dorsage Form</h3>

                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <th style="width: 50%;">Dorsage Form Name</th>
                            <td>@Model.DorsageFormName</td>
                        </tr>
                    </tbody>
                </table>

                <form asp-action="DeleteDorsage" method="post" onsubmit="return confirmDelete();">
                    <input type="hidden" asp-for="DorsageFormId" />

                    <div class="text-center mt-4">
                        <input type="submit" value="Delete" class="btn btn-danger me-2" />
                        <a asp-action="IndexDorsageForm" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete() {
            return confirm("⚠️ Are you sure you want to delete this Dorsage Form?");
        }
    </script>
}
