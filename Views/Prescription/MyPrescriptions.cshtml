@model IEnumerable<PrescribingSystem.Models.Prescription>

@{
    ViewData["Title"] = "My Prescriptions";
}

<div class="container mt-4">
    <h2>My Prescriptions</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have not uploaded any prescriptions yet.
        </div>
    }
    else
    {
        <table class="table table-striped table-dark">
            <thead>
                <tr>
                    <th>Uploaded At</th>
                    <th>Doctor Name</th>
                    <th>Status</th>
                    <th>File</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prescription in Model)
                {
                    <tr>
                        <td>@prescription.PrescriptionDate.ToString("dddd, dd, MMMM, HH:mm")</td>
                        <td>@prescription.DoctorName</td>
                        <td>@Enum.GetName(typeof(PrescriptionStatus), prescription.PrescriptionStatus)</td>
                        <td>
                            <a href="@Url.Action("Download", "Prescription", new { id = prescription.PrescriptionId })"
                               class="btn btn-primary">
                                View / Download
                            </a>
                        </td>
                        <td>
                            <a href="@Url.Action("PrescriptionDetails", "Prescription", new { id = prescription.PrescriptionId })"
                               class="btn btn-success">
                                Open
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

