@model IEnumerable<PrescribingSystem.Models.Prescription>

@{
    ViewData["Title"] = "My Prescriptions";
    //Layout = "_CustomerLayout";

    var processed = Model
       .Where(p => p.PrescriptionStatus == PrescriptionStatus.Processed)
       .OrderBy(p => p.PrescriptionDate)
       .ToList();

    var unprocessed = Model
        .Where(p => p.PrescriptionStatus == PrescriptionStatus.Pending)
        .OrderByDescending(p => p.PrescriptionDate)
        .ToList();
}

<div class="container mt-4">

     <!-- Alert messages -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <h2>My Prescriptions</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have not uploaded any prescriptions yet.
        </div>
    }
    else
    {

        <!-- Tabs navigation -->
        <ul class="nav nav-tabs form-container p-3" id="prescriptionTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="processed-tab" data-bs-toggle="tab" data-bs-target="#processed" type="button" role="tab" aria-controls="processed" aria-selected="true">
                    Processed Prescriptions
                    <span class="badge ms-1">@processed.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="unprocessed-tab" data-bs-toggle="tab" data-bs-target="#unprocessed" type="button" role="tab" aria-controls="unprocessed" aria-selected="false">
                    Unprocessed Prescriptions
                    <span class="badge ms-1">@unprocessed.Count</span>
                </button>
            </li>
        </ul>


        <!-- Tabs content -->
        <div class="tab-content mt-3 px-2" id="prescriptionTabsContent">
            <!-- Upcoming -->
            <div class="tab-pane fade show active" id="processed" role="tabpanel" aria-labelledby="processed-tab">
                @if (processed.Any())
                {
                    <table class="table table-striped table-dark">
                        <thead>
                            <tr>
                                <th>Uploaded At</th>
                                <th>Doctor Name</th>
                                <th>Should Process</th>
                                <th>Status</th>
                                <th>File</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prescription in processed)
                            {
                                <tr>
                                    <td>@prescription.PrescriptionDate.ToString("dddd, dd, MMMM, HH:mm")</td>
                                    <td>@prescription.DoctorName</td>
                                    <td>
                                        @(prescription.ShouldProcess == true ? "Yes" :
                                                            prescription.ShouldProcess == false ? "No" : "Pending")
                                    </td>
                                    <td>@Enum.GetName(typeof(PrescriptionStatus), prescription.PrescriptionStatus)</td>
                                    <td>
                                        <a href="@Url.Action("Download", "Prescription", new { prescriptionId = prescription.PrescriptionId })"
                                           class="btn btn-outline-primary">
                                            View / Download
                                        </a>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("PrescriptionDetails", "Prescription", new { prescriptionId = prescription.PrescriptionId })"
                                           class="btn btn-success">
                                            Open
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                   @*  @foreach (var prescription in processed)
                    {
                        @Html.Partial("_UserTripCard", processed)
                    } *@
                }
                else
                {
                    <div class="alert alert-info">You have no processed prescriptions yet.</div>
                }
            </div>

            <!-- Past -->
            <div class="tab-pane fade" id="unprocessed" role="tabpanel" aria-labelledby="unprocessed-tab">
                @if (unprocessed.Any())
                {
                    <table class="table table-striped table-dark">
                        <thead>
                            <tr>
                                <th>Uploaded At</th>                              
                                <th>Should Process</th>
                                <th>Status</th>
                                <th>File</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prescription in unprocessed)
                            {
                                <tr>
                                    <td>@prescription.PrescriptionDate.ToString("dddd, dd, MMMM, HH:mm")</td>
                                    <td>
                                        @(prescription.ShouldProcess == true ? "Yes" :
                                                            prescription.ShouldProcess == false ? "No" : "Pending")
                                    </td>
                                    <td>@Enum.GetName(typeof(PrescriptionStatus), prescription.PrescriptionStatus)</td>
                                    <td>
                                        <a href="@Url.Action("Download", "Prescription", new { prescriptionId = prescription.PrescriptionId })"
                                           class="btn btn-outline-primary">
                                            View / Download
                                        </a>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("EditPrescription", "Prescription", new { prescriptionId = prescription.PrescriptionId })"
                                           class="btn btn-success">
                                            Edit
                                        </a>
                                        <a href="@Url.Action("DeletePrescription", "Prescription", new { prescriptionId = prescription.PrescriptionId })"
                                           class="btn btn-danger">
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>


                    @* @foreach (var prescription in unprocessed)
                    {
                        @Html.Partial("_UserTripCard", prescription)
                    } *@
                }
                else
                {
                    <div class="alert alert-light">No unprocessed prescriptions yet.</div>
                }
            </div>
        </div>

    }
</div>

