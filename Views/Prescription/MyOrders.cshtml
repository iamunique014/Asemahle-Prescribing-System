@model IEnumerable<PrescribingSystem.Models.PrescriptionOrders>

@{
    ViewData["Title"] = "My Orders";
}

@* @{
    Layout = "_CustomerLayout";
} *@

<div class="row customer-container">
    <div class="col-md-3 nav-buttons">
        <partial name="_CustomerNavButtons" />
    </div>
    <div class="col-md-9">
        <div class="container">
            <h2>My Orders</h2>

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    You have not placed any orders yet.
                    <a asp-controller="CustomerOrders" asp-action="OrderPrescribedMedication" class="btn btn-light w-40" style="color:black;">Place an Order</a>
                </div>
            }
            else
            {
                <table class="table table-striped table-dark">
                    <thead>
                        <tr>
                            <th>Order Date</th>
                            <th>PrescriptionId</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>@order.OrderDate.ToString("dddd, dd, MMMM, HH:mm")</td>
                                @*    <td>@order.PrescriptionId</td> *@
                                <td>@Enum.GetName(typeof(OrderStatus), order.OrderStatus)</td>
                                <td>
                                    <a href="@Url.Action("DeleteOrder", "Prescription", new { orderId = order.PrescriptionOrdersId })"
                                       class="btn btn-outline-primary">
                                        View / Download
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

    </div>
</div>
