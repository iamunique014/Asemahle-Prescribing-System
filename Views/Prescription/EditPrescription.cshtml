@using PrescribingSystem.Models.ViewModels
@model PrescriptionUploadViewModel
@{
    ViewData["Title"] = "Edit Prescription";
}

<div class="container mt-4">
    <h2 class="mb-3">@ViewData["Title"]</h2>

    <form asp-action="EditPrescription" method="post" enctype="multipart/form-data">
        @* Hidden field to retain prescription ID *@
        <input type="hidden" asp-for="PrescriptionId" />

        @if (Model.HasFile)
        {
            <div class="mb-3">
                <label class="form-label fw-bold">Current Prescription File</label>
                <div>
                    <a href="@Model.ExistingFilePath" target="_blank" class="btn btn-outline-secondary btn-sm">
                        View Existing PDF
                    </a>
                </div>
            </div>
        }

        <div class="mb-3">
            <label asp-for="PrescriptionFile" class="form-label fw-bold">Upload New Prescription (PDF)</label>
            <input asp-for="PrescriptionFile" type="file" accept=".pdf" class="form-control" />
            <span asp-validation-for="PrescriptionFile" class="text-danger"></span>
            <small class="form-text text-muted">
                Leave blank to keep the existing prescription file.
            </small>
        </div>

        <div class="form-check mb-3">
            <input asp-for="ShouldProcess" class="form-check-input" type="checkbox" />
            <label asp-for="ShouldProcess" class="form-check-label">
                Process this prescription immediately
            </label>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="MyPrescriptions" class="btn btn-secondary ms-2">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}