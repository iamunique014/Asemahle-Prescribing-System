@using PrescribingSystem.Models.ViewModels
@model EditCustomerProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container mt-4">
    <h2 class="mb-3">Edit Your Profile</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form asp-action="EditProfile" method="post">
        <div class="form-group mb-3">
            <label asp-for="FirstName"></label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="LastName"></label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="CellphoneNumber"></label>
            <input asp-for="CellphoneNumber" class="form-control" />
            <span asp-validation-for="CellphoneNumber" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" readonly />
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-controller="Landing" asp-action="Landing" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
