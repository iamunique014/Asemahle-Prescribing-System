@using PrescribingSystem.Models.ViewModels
@model ManageAllergiesViewModel
@{
    ViewData["Title"] = "Manage Allergies";
}

<div class="row customer-container mt-4">
    <div class="col-md-3 nav-buttons">
        <partial name="_CustomerNavButtons" />
    </div>

    <div class="col-md-9">
        <div class="container">
            <div class="card shadow-sm border-0 p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0">Manage Your Allergies</h4>
                </div>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success mb-4">@TempData["Success"]</div>
                }

                <form asp-action="ManageAllergies" method="post">
                    <div class="card p-3 shadow-sm mb-4" style="max-height: 400px; overflow-y: auto;">
                        @if (Model.AvailableAllergies != null && Model.AvailableAllergies.Any())
                        {
                            <div class="row">
                                @foreach (var allergy in Model.AvailableAllergies)
                                {
                                    <div class="col-md-6 mb-2">
                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="SelectedAllergyIds"
                                                   value="@allergy.Value"
                                                   @(allergy.Selected ? "checked" : "") />
                                            <label class="form-check-label">@allergy.Text</label>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No active ingredients available to select.</p>
                        }
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">Save Allergies</button>
                        <a asp-controller="Landing" asp-action="Landing" class="btn btn-secondary ms-2">Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
