@{
    Layout = "_LayoutCustomerCare";

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.4.0/fonts/remixicon.css"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/css/CustomerCare.css" asp-append-version="true" />

    <title>Ibhayi-Pharmacy</title>
</head>
<body>

    <header>

        <nav class="section__container nav__container">
            <div class="nav__logo">Ibhayi-<span>Pharmacy</span></div>
            <nav class="section__container nav__container" color="black">
                @* <div class="nav__logo">e-<span>Nompilo</span></div> *@
                <ul class="nav__links">
                    <li class="nav-item">
                        <a class="nav__logo" asp-area="" asp-controller="Customer" asp-action="CustomerCare">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav__logo" asp-area="" asp-controller="AboutUs" asp-action="AboutUs">About Us</a>
                    </li>
                    <li class="nav-item active">
                        <a class="nav__logo" asp-area="" asp-controller="Profile" asp-action="Profile">Profile</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav__logo" asp-area="" asp-controller="ContactUs" asp-action="ContactUs">Contact Us</a>
                    </li>
                </ul>
            </nav>
            <div><a class="btn btn-primary" asp-area="" asp-controller="Profile" asp-action="Profile">Registration</a></div>
        </nav>
    </header>
    <div class="section__container header__container">
        <div class="header__content">

            <p>
                <h2>Welcome to Ibhayi Pharmacy – Your Trusted Partner in Health</h2>


                At Ibhayi Pharmacy, we are committed to providing high-quality, affordable healthcare and personalized service to our community.s
                Whether you need prescription medications, over-the-counter products, or expert health advice, our knowledgeable pharmacists and friendly staff are here to help.
                We believe in building lasting relationships with our customers through care, trust, and convenience.Explore our services, shop online, and experience pharmacy care that puts your well-being first.
            </p>



        </div>

    </div>


    <section class="section__container service__container">
        <div class="service__header">
            <div class="service__header__content">
                <h2 class="section__header">Our Special service</h2>
                <p>
                    Beyond simply providing medical care, our commitment lies in
                    delivering unparalleled service tailored to your unique needs.
                </p>
            </div>
            @* <button class="service__btn">Ask A Service</button> *@
        </div>
        <div class="service__grid" s>
            <div class="service__card">
                <span><i class="ri-book-fill"></i></span>
                <h4>Prescription</h4>
                <p>
                    Protect yourself and your loved ones with Vaccination.
                    Safeguarding health, one shot at a time.
                </p>
                <a class="btn btn-primary" style="color:white" asp-area="" asp-controller="UploadPrescription" asp-action="UploadPrescription">Learn more</a>
            </div>
            <div class="service__card">
                <span><i class="ri-hand-heart-fill"></i></span>
                <h4>Reports</h4>
                <p>
                    Nurturing new life with Ibhayi Pharmacy.
                    Generate your<br /> Reports
                    
                </p>
                <a class="btn btn-primary" style="color:white" asp-area="" asp-controller="Report" asp-action="GetReport">Learn More</a>

            </div>
            <div class="service__card">
                <span><i class="ri-calculator-fill"></i></span>
                <h4>Notification Service</h4>
                <p>
                 Take control on where you would like to be notified for your available orders
                </p>
                <a class="btn btn-primary" style="color:white" asp-area="" asp-controller="Notification" asp-action="Notification">Learn More</a>

            </div>
            @*  <div class="service__card">
                <span><i class="ri-capsule-fill"></i></span>
                <h4>Chronic Medication</h4>
                <p>
                    Simplify your healthcare routine.
                    Conveniently collect your chronic medication with us.
                </p>
                <a class="btn btn-primary" style="color:white" asp-area="" asp-controller="ChronicMedication" asp-action="Chronic">Learn More</a>

            </div> *@
            @* <div class="service__card">
                <span><i class="ri-mental-health-fill"></i></span>
                <h4>Counselling</h4>
                <p>
                    Embrace healing and hope through Counseling.
                    We're here to support your emotional well-being.
                </p>
                <a class="btn btn-primary" style="color:white" asp-area="" asp-controller="Counseling" asp-action="Counsel">Learn More</a>
            </div> *@
        </div>
    </section>
    <section class="section__container about__container">
        <div class="about__content">
            <h2 class="section__header">About Us</h2>
            <p>
                Welcome to our Pharmacy website, your one-stop destination for
                reliable and comprehensive health care information. We are committed
                to promoting wellness and providing valuable resources to empower you
                on your health journey.
            </p>
            <p>
                Explore our extensive collection of expertly written articles and
                guides covering a wide range of health topics. From understanding
                common medical conditions to tips for maintaining a healthy lifestyle,
                our content is designed to educate, inspire, and support you in making
                informed choices for your health.
            </p>
            <p>
                Discover practical health tips and lifestyle advice to optimize your
                physical and mental well-being. We believe that small changes can lead
                to significant improvements in your quality of life, and we're here to
                guide you on your path to a healthier and happier you.
            </p>
        </div>
        <div class="about__image">
            <img src="~/css/CustomerPharmacist.jpg" alt="about" />
        </div>
    </section>

    <section class="section__container why__container">
        <div class="why__image">
            <img src="~/css/91b168a85e42270e3308df580ba9cf0f.jpg" alt="why choose us" />
        </div>
        <div class="why__content">
            <h2 class="section__header">Why Choose Us</h2>
            <p>
                With a steadfast commitment to your well-being, our team of highly
                trained healthcare professionals ensures that you receive nothing
                short of exceptional patient experiences.
            </p>
            <div class="why__grid">
                <span><i class="ri-hand-heart-line"></i></span>
                <div>
                    <h4>Intensive Care</h4>
                    <p>
                        Our Intensive Care Unit is equipped with advanced technology and
                        staffed by team of professionals
                    </p>
                </div>
                <span><i class="ri-truck-line"></i></span>
                <div>
                    <h4>Free Ambulance Car</h4>
                    <p>
                        A compassionate initiative to prioritize your health and
                        well-being without any financial burden.
                    </p>
                </div>
                <span><i class="ri-hospital-line"></i></span>
                <div>
                    <h4>Medical and Surgical</h4>
                    <p>
                        Our Medical and Surgical services offer advanced healthcare
                        solutions to address medical needs.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="section__container doctors__container">
        <div class="doctors__header">
            <div class="doctors__header__content">
                <h2 class="section__header">Our Special Doctors</h2>
                <p>
                    We take pride in our exceptional team of doctors, each a specialist
                    in their respective fields.
                </p>
            </div>

        </div>
        <div class="doctors__grid">
            <div class="doctors__card">
                <div class="doctors__card__image">
                    <img src="~/css/BlackDoc.jpg" alt="doctor" />
                    <div class="doctors__socials">
                        <span><i class="ri-instagram-line"></i></span>
                        <span><i class="ri-facebook-fill"></i></span>
                        <span><i class="ri-heart-fill"></i></span>
                        <span><i class="ri-twitter-fill"></i></span>
                    </div>
                </div>
                <h4>Dr. Atini Menzi</h4>
                <p>Gynaecologist</p>
            </div>
            <div class="doctors__card">
                <div class="doctors__card__image">
                    <img src="~/css/b602657fb51e564d6f6be9c1fb8a32f9.jpg" alt="doctor" />
                    <div class="doctors__socials">
                        <span><i class="ri-instagram-line"></i></span>
                        <span><i class="ri-facebook-fill"></i></span>
                        <span><i class="ri-heart-fill"></i></span>
                        <span><i class="ri-twitter-fill"></i></span>
                    </div>
                </div>
                <h4>Dr. Ashley smith</h4>
                <p>Pyschologist</p>
            </div>
            <div class="doctors__card">
                <div class="doctors__card__image">
                    <img src="~/css/Vertical.jpg" alt="doctor" />
                    <div class="doctors__socials">
                        <span><i class="ri-instagram-line"></i></span>
                        <span><i class="ri-facebook-fill"></i></span>
                        <span><i class="ri-heart-fill"></i></span>
                        <span><i class="ri-twitter-fill"></i></span>
                    </div>
                </div>
                <h4>Dr. Michael Lee</h4>
                <p>Pharmacist</p>
            </div>
        </div>
    </section>

    <footer class="footer">
        <div class="section__container footer__container">
            <div class="footer__col">
                <h3>IBhayi-<span>Pharmacy</span></h3>
                <p>
                    We are honored to be a part of your healthcare journey and committed
                    to delivering compassionate, personalized, and top-notch care every
                    step of the way.
                </p>
                <p>
                    Trust us with your health, and let us work together to achieve the
                    best possible outcomes for you and your loved ones.
                </p>
            </div>
            <div class="footer__col">
                <h4>About Us</h4>
                <p>Home</p>
                <p>About Us</p>
                <p>Work With Us</p>
                <p>Our Blog</p>
                <p>Terms & Conditions</p>
            </div>
            <div class="footer__col">
                <h4>Services</h4>
                <p>Search Terms</p>
                <p>Advance Search</p>
                <p>Privacy Policy</p>

            </div>
            <div class="footer__col">
                <h4>Contact Us</h4>
                <p>
                    <i class="ri-map-pin-2-fill"></i> 64, Mackay str Richmond Hill, Port Elizabeth
                </p>
                <p><i class="ri-mail-fill"></i> IbhayiPharmacy@gmail.com</p>
                <p><i class="ri-phone-fill"></i> (+012) 3456 789</p>
            </div>
        </div>
        <div class="footer__bar">
            <div class="footer__bar__content">
                <p>Copyright © 2025 Ibhayi Pharmacy. All rights reserved.</p>
                <div class="footer__socials">
                    <span><i class="ri-instagram-line"></i></span>
                    <span><i class="ri-facebook-fill"></i></span>
                    <span><i class="ri-heart-fill"></i></span>
                    <span><i class="ri-twitter-fill"></i></span>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>
