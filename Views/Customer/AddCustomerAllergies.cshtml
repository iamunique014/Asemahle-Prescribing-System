@model IEnumerable<PrescribingSystem.Models.ViewModels.ActiveIngredientViewModel>

<h2>Active Ingredients</h2>

<form>
    @foreach(var ingredient in Model)
    {
        <div>
            <input type="checkbox" name="selectedAllergies" value="@ingredient.id" />
            @ingredient.Name
        </div>
    }
    <button type="submit">Save Allergies</button>
</form>