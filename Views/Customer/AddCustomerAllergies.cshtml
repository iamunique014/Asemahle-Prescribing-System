@model PrescribingSystem.Models.ViewModels.AddCustomerAllergiesViewModel

<h2>Select Allergies</h2>

<form asp-action="AddCustomerAllergies" asp-controller="Customer" method="post">
    <input type="hidden" asp-for="UserId" />

    @foreach (var ingredient in Model.ActiveIngredients)
    {
        <div>
            <input type="checkbox"
                   name="SelectedAllergies"
                   value="@ingredient.id" />
            @ingredient.Name
        </div>
    }

    <button type="submit">Save Allergies</button>
</form>
