@{
    Layout = "_LayoutReports";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.4.0/fonts/remixicon.css"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/css/CustomerCare.css" asp-append-version="true" />

    <title>Ibhayi-Pharmacy</title>

</head>
<body>

    <header>

        <nav class="section__container nav__container">
            <div class="nav__logo">Ibhayi-<span>Pharmacy</span></div>
            <nav class="section__container nav__container" color="black">
                @* <div class="nav__logo">e-<span>Nompilo</span></div> *@
                <ul class="nav__links">
                    <li class="nav-item">
                        <a class="nav__logo" asp-area="" asp-controller="Customer" asp-action="CustomerCare">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav__logo" asp-area="" asp-controller="AboutUs" asp-action="AboutUs">About Us</a>
                    </li>
                    <li class="nav-item active">
                        <a class="nav__logo" asp-area="" asp-controller="Services" asp-action="Services">Services</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav__logo" asp-area="" asp-controller="ContactUs" asp-action="Add">Contact Us</a>
                    </li>
                </ul>
            </nav>
            <div><a class="btn btn-primary" asp-area="" asp-controller="Profile" asp-action="Profile">Registration</a></div>
        </nav>
    </header>


    <section class="section__container about__container">
        <div class="about__content">
            <h2 class="section__header">Welcome to the Load Prescription Service</h2>
            <p>
                To upload a prescription in the system, first navigate to the prescription upload section.
                This section is designed to allow users to conveniently submit their medical
                prescriptions for processing, whether for ordering medication,
                verifying treatments, or storing medical records
                Make sure you have a clear digital copy of your prescription saved
                on your device in a common format such as PDF, JPEG, or PNG.
            </p>
            <p>
                Once you are in the upload section, you will typically see a button labeled “Choose File,” “Upload,” or “Browse.”
                Click this button to open your device’s file explorer, then locate and select the prescription file you wish to upload.
                After selecting the file, its name will usually appear next to the button, confirming your selection. Some systems may
                display a preview of the document or allow you to add additional information, such as the prescription date or doctor’s
                name, before final submission.
            </p>
            <p>
                After ensuring that the correct file is selected, click the “Submit,” “Upload,” or “Save” button to complete the process.
                The system may take a few moments to process the file, especially if it is large or includes images. Once the upload is successful,
                you will usually see a confirmation message or the uploaded file listed in your account. If there is an error, such as an unsupported
                file type or a size limit exceeded, the system will prompt you with a message so you can correct the issue and try again.
            </p>
        </div>
        <div class="about__image">
            <img src="~/css/LoadPrescription2.jpg" alt="about" />
        </div>
    </section>
    <section class="section__container service__container">
        <div class="service__header">
            <div class="service__header__content">
                <h2 class="section__header">Prescription Services</h2>
                <p>
                    Beyond simply providing medical care, our commitment lies in
                    delivering unparalleled service tailored to your unique needs.
                </p>
            </div>
            @* <button class="service__btn">Ask A Service</button> *@
        </div>
        <div class="service__grid">
            <div class="service__card">
                <span><i class="ri-syringe-fill"></i></span>
                <h4>Load Prescription</h4>
                <p>
                    Load Prescription on this Option!
                </p>
                <a class="btn btn-primary" style="color:white" asp-area="" asp-controller="UploadPrescription" asp-action="loadPrescription">Load File</a>
            </div>
            <div class="service__card">
                <span><i class="ri-hand-heart-fill"></i></span>
                <h4> Prescription Status </h4>
                <p>
                    Check the Prescripton status.
                </p>
                <a class="btn btn-primary" style="color:white" asp-area="" asp-controller="UploadPrescription" asp-action="PrescriptionStatus"> order Status</a>

            </div>
            <div class="service__card">
                <span><i class="ri-home-heart-fill"></i></span>
                <h4>Request repeats</h4>
                <p>
                   Prescription repeats

                </p>
                <a class="btn btn-primary" style="color:white" asp-area="" asp-controller="Repeats" asp-action="Repeats">Manage Repeats</a>

            </div>

        </div>
    </section>












































    <footer class="footer">
        <div class="section__container footer__container">
            <div class="footer__col">
                <h3>IBhayi-<span>Pharmacy</span></h3>
                <p>
                    We are honored to be a part of your healthcare journey and committed
                    to delivering compassionate, personalized, and top-notch care every
                    step of the way.
                </p>
                <p>
                    Trust us with your health, and let us work together to achieve the
                    best possible outcomes for you and your loved ones.
                </p>
            </div>
            <div class="footer__col">
                <h4>About Us</h4>
                <p>Home</p>
                <p>About Us</p>
                <p>Work With Us</p>
                <p>Our Blog</p>
                <p>Terms & Conditions</p>
            </div>
            <div class="footer__col">
                <h4>Services</h4>
                <p>Search Terms</p>
                <p>Advance Search</p>
                <p>Privacy Policy</p>

            </div>
            <div class="footer__col">
                <h4>Contact Us</h4>
                <p>
                    <i class="ri-map-pin-2-fill"></i> 64, Mackay str Richmond Hill, Port Elizabeth
                </p>
                <p><i class="ri-mail-fill"></i> IbhayiPharmacy@gmail.com</p>
                <p><i class="ri-phone-fill"></i> (+012) 3456 789</p>
            </div>
        </div>
        <div class="footer__bar">
            <div class="footer__bar__content">
                <p>Copyright © 2025 Ibhayi Pharmacy. All rights reserved.</p>
                <div class="footer__socials">
                    <span><i class="ri-instagram-line"></i></span>
                    <span><i class="ri-facebook-fill"></i></span>
                    <span><i class="ri-heart-fill"></i></span>
                    <span><i class="ri-twitter-fill"></i></span>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>

