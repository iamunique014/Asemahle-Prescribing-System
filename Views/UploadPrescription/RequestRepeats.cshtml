@{
    Layout = "_LayoutReports";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.4.0/fonts/remixicon.css"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/css/CustomerCare.css" asp-append-version="true" />@* 
     *@
    <title>The Innovative Geeks | eNompilo</title>

</head>
<body>

    <header>

        <nav class="section__container nav__container">
            <div class="nav__logo">Ibhayi-<span>Pharmacy</span></div>
            <nav class="section__container nav__container" color="black">
                @* <div class="nav__logo">e-<span>Nompilo</span></div> *@
                <ul class="nav__links">
                    <li class="nav-item">
                        <a class="nav__logo" asp-area="" asp-controller="UploadPrescription" asp-action="UploadPrescription">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav__logo" asp-area="" asp-controller="AboutUs" asp-action="AboutUs">About Us</a>
                    </li>
                    <li class="nav-item active">
                        <a class="nav__logo" asp-area="" asp-controller="Services" asp-action="Services">Services</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav__logo" asp-area="" asp-controller="ContactUs" asp-action="Add">Contact Us</a>
                    </li>
                </ul>
            </nav>
            <div><a class="btn btn-primary" asp-area="" asp-controller="Profile" asp-action="Profile">Registration</a></div>
        </nav>

    </header>
    <style>
      

        .container {
            background-color: white;
            margin-top: 100px;
            margin-bottom: 50px;
        }

        h2 {
            text-align: center;
            color: #333;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-weight: bold;
            margin-bottom: 6px;
            color: #444;
        }

        select, input[type="number"], input[type="date"] {
            width: 100%;
            padding: 10px;
            font-size: 16px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        .form-toggle {
            display: flex;
            gap: 15px;
            margin-bottom: 15px;
        }

            .form-toggle input {
                margin-right: 5px;
            }

        button {
            width: 100%;
            padding: 12px;
            font-size: 16px;
            background-color: #007bff;
            border: none;
            color: white;
            border-radius: 5px;
            cursor: pointer;
        }

            button:hover {
                background-color: #0056b3;
            }

        .confirmation {
            margin-top: 20px;
            color: green;
            text-align: center;
            display: none;
        }
    </style>
    
    

        <div class="container">
            <h2>Repeat Prescription Request</h2>

            <div class="form-group">
                <label for="prescriptionSelect">Select Prescription</label>
                <select id="prescriptionSelect">
                    <option value="">-- Select a Prescription --</option>
                    <option value="RX001">RX001 - Amoxicillin</option>
                    <option value="RX002">RX002 - Ibuprofen</option>
                    <option value="RX003">RX003 - Paracetamol</option>
                </select>
            </div>

            <div class="form-group">
                <label>Choose Repeat Option</label>
                <div class="form-toggle">
                    <label><input type="radio" name="repeatType" value="quantity" checked> Quantity</label>
                    <label><input type="radio" name="repeatType" value="date"> Pack on Date</label>
                </div>
            </div>

            <div class="form-group" id="quantityGroup">
                <label for="quantity">Quantity</label>
                <input type="number" id="quantity" min="1" placeholder="e.g., 30 tablets">
            </div>

            <div class="form-group" id="dateGroup" style="display:none;">
                <label for="packDate">Packing Date</label>
                <input type="date" id="packDate">
            </div>

            <button onclick="submitRepeat()">Submit Repeat Request</button>

            <div class="confirmation" id="confirmationMessage">Repeat request submitted successfully!</div>
        </div>





























<footer class="footer">
    <div class="section__container footer__container">
        <div class="footer__col">
            <h3>IBhayi-<span>Pharmacy</span></h3>
            <p>
                We are honored to be a part of your healthcare journey and committed
                to delivering compassionate, personalized, and top-notch care every
                step of the way.
            </p>
            <p>
                Trust us with your health, and let us work together to achieve the
                best possible outcomes for you and your loved ones.
            </p>
        </div>
        <div class="footer__col">
            <h4>About Us</h4>
            <p>Home</p>
            <p>About Us</p>
            <p>Work With Us</p>
            <p>Our Blog</p>
            <p>Terms & Conditions</p>
        </div>
        <div class="footer__col">
            <h4>Services</h4>
            <p>Search Terms</p>
            <p>Advance Search</p>
            <p>Privacy Policy</p>

        </div>
        <div class="footer__col">
            <h4>Contact Us</h4>
            <p>
                <i class="ri-map-pin-2-fill"></i> 64, Mackay str Richmond Hill, Port Elizabeth
            </p>
            <p><i class="ri-mail-fill"></i> IbhayiPharmacy@gmail.com</p>
            <p><i class="ri-phone-fill"></i> (+012) 3456 789</p>
        </div>
    </div>




    <div class="footer__bar">
        <div class="footer__bar__content">
            <p>Copyright © 2025 Ibhayi Pharmacy. All rights reserved.</p>
            <div class="footer__socials">
                <span><i class="ri-instagram-line"></i></span>
                <span><i class="ri-facebook-fill"></i></span>
                <span><i class="ri-heart-fill"></i></span>
                <span><i class="ri-twitter-fill"></i></span>
            </div>
        </div>
    </div>
</footer>
<script src="/js/Repeats.js"></script>
</body>
</html>