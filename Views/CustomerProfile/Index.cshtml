@model CustomerProfileViewModel
@{
    ViewData["Title"] = "ProfileManagement";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}





<h2>Customer Profile</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-action="Index" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdentityNumber" class="form-label"></label>
        <input asp-for="IdentityNumber" class="form-control" />
        <span asp-validation-for="IdentityNumber" class="text-danger"></span>
    </div>

    <div class=" mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    @*   <div class="form-group mb-2">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </d *@

    <div class="mb-3">
        <label class="form-label">Allergies</label>
        <div>
            @foreach (var allergy in Model.AvailableAllergies)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox"
                           name="SelectedAllergyIds"
                           value="@allergy.Value" />
                    @if (allergy.Selected)
                    {
                        <text>checked</text>
                    }
                    />
                    <label class="form-check-label">@allergy.Text</label>
                </div>
            }
            }


        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save Profile</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

