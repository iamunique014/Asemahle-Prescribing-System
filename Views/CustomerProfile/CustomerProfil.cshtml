@using PrescribingSystem.AunthViewModels;
@model CustomerProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<h2>My Profile</h2>

@if (TempData["ProfileSaved"] != null)
{
    <div class="alert alert-success">@TempData["ProfileSaved"]</div>
}

<form asp-controller="CustomerProfile" asp-action="CustomerProfil" method="post">
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Surname</label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Allergies (Active Ingredients)</label>
        <div class="border rounded p-2" style="max-height: 260px; overflow:auto;">
            @foreach (var ing in Model.AvailableIngredients)
            {
                var isChecked = Model.SelectedAllergyIds.Contains(ing.ActiveIngredientId);
                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           name="SelectedAllergyIds"
                           value="@ing.ActiveIngredientId"
                           @(isChecked ? "checked" : "") />
                    <label class="form-check-label">@ing.ActiveIngredientName</label>
                </div>
            }
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

